inst:component-mapping-data-contract-definition-openapi a dl:ComponentImplementationMapping ; dl:identifier "data-contract-definition-openapi" ; dl:mapsComponentType dl:DataContractDefinition ; dl:implementationOption inst:standard-openapi ; dl:mappingRationale "OpenAPI is a candidate implementation option for describing HTTP-facing contract interfaces and payload schemas that a data product may expose." ; dl:authoritativeSource "https://spec.openapis.org/oas/latest.html"^^xsd:anyURI ; dl:evidenceStatus "CURATED_DESIGN_MAPPING" .
inst:component-mapping-data-contract-definition-avro a dl:ComponentImplementationMapping ; dl:identifier "data-contract-definition-avro" ; dl:mapsComponentType dl:DataContractDefinition ; dl:implementationOption inst:standard-avro ; dl:mappingRationale "Apache Avro is a candidate schema and serialization option for contracts that exchange typed records across producers and consumers." ; dl:authoritativeSource "https://avro.apache.org/docs/"^^xsd:anyURI ; dl:evidenceStatus "CURATED_DESIGN_MAPPING" .
