inst:component-mapping-source-connectivity-kafka a dl:ComponentImplementationMapping ; dl:identifier "source-connectivity-kafka" ; dl:mapsComponentType dl:SourceConnectivity ; dl:implementationOption inst:standard-kafka ; dl:mappingRationale "Apache Kafka is a candidate implementation option for connecting to event streams as a pipeline source; brokers, topics and consumer groups remain operational concerns outside this mapping." ; dl:authoritativeSource "https://kafka.apache.org/documentation/"^^xsd:anyURI ; dl:evidenceStatus "CURATED_DESIGN_MAPPING" .
