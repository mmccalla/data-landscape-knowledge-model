inst:component-mapping-store-write-data-product-parquet a dl:ComponentImplementationMapping ; dl:identifier "store-write-data-product-parquet" ; dl:mapsComponentType dl:StoreWriteDataProduct ; dl:implementationOption inst:standard-parquet ; dl:mappingRationale "Apache Parquet is a candidate columnar file-format option for materialising stored analytical outputs; table-format semantics (snapshots, transactions) still require Iceberg, Delta or similar when needed." ; dl:authoritativeSource "https://parquet.apache.org/docs/"^^xsd:anyURI ; dl:evidenceStatus "CURATED_DESIGN_MAPPING" .
