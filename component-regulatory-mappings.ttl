# Curated regulatory-relevance mappings derived from the cited primary sources.
# These assertions identify design context; they do not prove compliance or legal sufficiency.
# Coverage is intentionally incomplete: blank components and omitted regulations are not backlog debt.

@prefix dl: <https://polymathic.co.uk/data-landscape/ontology/> .
@prefix inst: <https://polymathic.co.uk/data-landscape/instance/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

inst:component-regulatory-secure-read-access-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-gdpr" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Secure read access is a direct technical means for restricting who may access personal data and for supporting confidentiality controls; applicability and the appropriate measures remain context- and risk-dependent." ; dl:regulatoryRequirementReference "GDPR Article 32(1)(b), 32(2) and 32(4)" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-read-access-hipaa a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-hipaa" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-hipaa ; dl:mappingRationale "Secure read access is a direct technical means for the HIPAA Security Rule access-control standard that allows access to ePHI only by authorised persons." ; dl:regulatoryRequirementReference "45 CFR 164.312(a)(1) — Access control" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html"^^xsd:anyURI ; dl:sourceVersion "HIPAA Security Rule currently in effect" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-read-access-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-nist-800-53" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Secure read access is a direct technical means for enforcing approved authorisations for logical access to information and system resources; selecting and configuring the policy remains an organisational control decision." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 AC-3 — Access Enforcement" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-read-access-ccpa-cpra a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-ccpa-cpra" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-ccpa-cpra ; dl:mappingRationale "Secure read access is a direct technical means for implementing reasonable security procedures that protect personal information from unauthorised access; CCPA still requires organisational policy and breach-response measures beyond access control alone." ; dl:regulatoryRequirementReference "Cal. Civ. Code § 1798.100(e) and § 1798.81.5 — reasonable security against unauthorised access" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1798.100"^^xsd:anyURI ; dl:sourceVersion "California Consumer Privacy Act as amended (CPRA)" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-read-access-dora a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-dora" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-dora ; dl:mappingRationale "Secure read access is a direct technical means for limiting logical access to information and ICT assets to legitimate and approved functions; DORA still requires broader ICT risk-management governance beyond access enforcement." ; dl:regulatoryRequirementReference "DORA Article 9(4)(c) — access rights limited to legitimate functions" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2022/2554" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-read-access-nis2 a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-nis2" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-nis2 ; dl:mappingRationale "Secure read access is a direct technical means for implementing access-control policies required under NIS2 cybersecurity risk-management measures; national transposition and organisational policy remain decisive for applicability." ; dl:regulatoryRequirementReference "NIS2 Article 21(2)(i) — access control policies and asset management" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"^^xsd:anyURI ; dl:sourceVersion "Directive (EU) 2022/2555" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-gdpr" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Secure write access is a direct technical means for protecting personal data against unauthorised alteration and for supporting integrity controls; it is only one part of the required technical and organisational measures." ; dl:regulatoryRequirementReference "GDPR Article 32(1)(b) and 32(2)" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-hipaa a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-hipaa" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-hipaa ; dl:mappingRationale "Secure write access is a direct technical means for protecting ePHI from improper alteration or destruction under the HIPAA Security Rule integrity standard." ; dl:regulatoryRequirementReference "45 CFR 164.312(c)(1) — Integrity" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.hhs.gov/hipaa/for-professionals/compliance-enforcement/audit/protocol/index.html"^^xsd:anyURI ; dl:sourceVersion "HIPAA Audit Protocol, updated July 2018" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-nist-800-53" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Secure write access is a direct technical means for detecting and protecting against unauthorised changes to information; integrity monitoring and write controls still require policy selection and operational evidence." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 SI-7 — Software, Firmware, and Information Integrity" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-ccpa-cpra a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-ccpa-cpra" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-ccpa-cpra ; dl:mappingRationale "Secure write access is a direct technical means for protecting personal information from unauthorised modification or destruction under California reasonable-security duties; it does not by itself satisfy CCPA consumer-rights obligations." ; dl:regulatoryRequirementReference "Cal. Civ. Code § 1798.100(e) and § 1798.81.5 — reasonable security against unauthorised modification or destruction" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1798.81.5"^^xsd:anyURI ; dl:sourceVersion "California Civil Code § 1798.81.5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-dora a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-dora" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-dora ; dl:mappingRationale "Secure write access is a direct technical means for minimising corruption or loss of data and for preventing impairment of authenticity and integrity; DORA still requires organisation-wide ICT security policies and monitoring." ; dl:regulatoryRequirementReference "DORA Article 9(3)(b) and 9(3)(c) — minimise corruption or loss; prevent integrity and confidentiality breaches" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2022/2554" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-source-connectivity-hipaa a dl:ComponentRegulatoryMapping ; dl:identifier "source-connectivity-hipaa" ; dl:mapsComponentType dl:SourceConnectivity ; dl:regulatoryContext inst:regulation-hipaa ; dl:mappingRationale "Source connectivity is a direct technical means for guarding ePHI during transmission over electronic networks, including integrity controls and encryption where appropriate; transmission security alone does not satisfy access or audit requirements." ; dl:regulatoryRequirementReference "45 CFR 164.312(e)(1) and 164.312(e)(2) — Transmission security, integrity controls and encryption" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-C/part-164/subpart-C/section-164.312"^^xsd:anyURI ; dl:sourceVersion "45 CFR 164.312 currently in effect" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-source-connectivity-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "source-connectivity-nist-800-53" ; dl:mapsComponentType dl:SourceConnectivity ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Source connectivity is a direct technical means for enforcing approved authorisations that control the flow of information between connected systems; flow policies and boundary devices must still be selected and maintained by the organisation." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 AC-4 — Information Flow Enforcement" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-source-connectivity-dora a dl:ComponentRegulatoryMapping ; dl:identifier "source-connectivity-dora" ; dl:mapsComponentType dl:SourceConnectivity ; dl:regulatoryContext inst:regulation-dora ; dl:mappingRationale "Source connectivity is a direct technical means for securing the means of transfer of data between systems supporting critical or important functions; DORA applicability remains limited to in-scope financial entities." ; dl:regulatoryRequirementReference "DORA Article 9(3)(a) — security of the means of transfer of data" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2022/2554" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-state-and-idempotency-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "state-and-idempotency-nist-800-53" ; dl:mapsComponentType dl:StateAndIdempotency ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "State management and idempotent transaction design are a direct technical means for transaction recovery through rollback and journaling in transaction-based systems; CP-10(2) does not prescribe a single orchestration product." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 CP-10(2) — Transaction Recovery" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-validation-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "validation-and-contract-binding-nist-800-53" ; dl:mapsComponentType dl:ValidationAndContractBinding ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Validation and contract binding are a direct technical means for checking information inputs and handling invalid inputs predictably; a contract implementation must still select and enforce the applicable constraints." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 SI-10 — Information Input Validation" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-validation-bcbs-239 a dl:ComponentRegulatoryMapping ; dl:identifier "validation-and-contract-binding-bcbs-239" ; dl:mapsComponentType dl:ValidationAndContractBinding ; dl:regulatoryContext inst:regulation-bcbs-239 ; dl:mappingRationale "Validation and contract binding are a direct technical means for checking accuracy and integrity constraints on risk and reporting data; BCBS 239 still expects broader governance, aggregation and reporting controls beyond pipeline validation." ; dl:regulatoryRequirementReference "BCBS 239 Principle 3 — Accuracy and integrity" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.bis.org/publ/bcbs239.htm"^^xsd:anyURI ; dl:sourceVersion "BCBS 239 (January 2013)" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-validation-eu-ai-act a dl:ComponentRegulatoryMapping ; dl:identifier "validation-and-contract-binding-eu-ai-act" ; dl:mapsComponentType dl:ValidationAndContractBinding ; dl:regulatoryContext inst:regulation-eu-ai-act ; dl:mappingRationale "Validation and contract binding are a direct technical means for data-preparation and quality checks that help keep training, validation and testing datasets as free of errors as possible; Article 10 applies to high-risk AI systems and does not make a pipeline automatically compliant." ; dl:regulatoryRequirementReference "EU AI Act Article 10(2) and 10(3) — data governance and dataset quality criteria" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2024/1689" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-gdpr" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Metadata registration is a direct technical means for capturing purposes, data categories, recipients, transfers, retention and security measures needed for records of processing; a catalogue record is not automatically a complete Article 30 record." ; dl:regulatoryRequirementReference "GDPR Article 30 — Records of processing activities" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-iso-11179 a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-iso-11179" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-iso-11179 ; dl:mappingRationale "Metadata registration directly aligns with the ISO/IEC 11179 metadata-registry family, including registration of dataset metadata, provenance, quality, fitness and risk information." ; dl:regulatoryRequirementReference "ISO/IEC 11179-33:2023 — Metamodel for data set registration" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.iso.org/standard/81725.html"^^xsd:anyURI ; dl:sourceVersion "ISO/IEC 11179-33:2023" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-bcbs-239 a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-bcbs-239" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-bcbs-239 ; dl:mappingRationale "Metadata registration is a direct technical means for documenting ownership, lineage, definitions and quality characteristics required by a coherent risk-data architecture; BCBS 239 does not prescribe a specific registry product." ; dl:regulatoryRequirementReference "BCBS 239 Principle 2 — Data architecture and IT infrastructure" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.bis.org/publ/bcbs239.htm"^^xsd:anyURI ; dl:sourceVersion "BCBS 239 (January 2013)" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-hipaa a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-hipaa" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-hipaa ; dl:mappingRationale "Metadata registration is a direct technical means for recording activity metadata that supports audit-control mechanisms in systems containing ePHI; catalogue metadata alone does not satisfy information-system activity review procedures." ; dl:regulatoryRequirementReference "45 CFR 164.312(b) — Audit controls" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-C/part-164/subpart-C/section-164.312"^^xsd:anyURI ; dl:sourceVersion "45 CFR 164.312 currently in effect" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-nist-800-53" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Metadata registration is a direct technical means for generating and retaining structured audit-record content about pipeline events; AU-12 still depends on the organisation defining event types under AU-2 and AU-3." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 AU-12 — Audit Record Generation" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-failure-isolation-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "failure-isolation-nist-800-53" ; dl:mapsComponentType dl:FailureIsolation ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Failure isolation is a direct technical means for limiting the impact of predictable component failures and for supporting controlled failure handling; NIST SI-13 still requires organisational failure analysis and recovery planning beyond isolation alone." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 SI-13 — Predictable Failure Prevention" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-failure-isolation-dora-art9 a dl:ComponentRegulatoryMapping ; dl:identifier "failure-isolation-dora-art9" ; dl:mapsComponentType dl:FailureIsolation ; dl:regulatoryContext inst:regulation-dora ; dl:mappingRationale "Failure isolation is a direct technical means for automated isolation of affected information assets and for network segmentation that can be severed to minimise contagion; DORA still requires broader detection, recovery and reporting controls." ; dl:regulatoryRequirementReference "DORA Article 9(4)(b) — isolate affected information assets; sever or segment network connections" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2022/2554" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-failure-isolation-dora-art11 a dl:ComponentRegulatoryMapping ; dl:identifier "failure-isolation-dora-art11" ; dl:mapsComponentType dl:FailureIsolation ; dl:regulatoryContext inst:regulation-dora ; dl:mappingRationale "Failure isolation is a direct technical means for containment measures, processes and technologies that limit further damage during ICT-related incidents; containment alone does not complete DORA response and recovery obligations." ; dl:regulatoryRequirementReference "DORA Article 11(2)(c) — containment measures suited to each type of ICT-related incident" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2022/2554" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-failure-isolation-nis2 a dl:ComponentRegulatoryMapping ; dl:identifier "failure-isolation-nis2" ; dl:mapsComponentType dl:FailureIsolation ; dl:regulatoryContext inst:regulation-nis2 ; dl:mappingRationale "Failure isolation is a direct technical means contributing to incident-handling measures that prevent or minimise the impact of incidents on services; NIS2 still requires national transposition and broader risk-management measures." ; dl:regulatoryRequirementReference "NIS2 Article 21(2)(b) — incident handling" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"^^xsd:anyURI ; dl:sourceVersion "Directive (EU) 2022/2555" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-workload-execution-orchestration-dora a dl:ComponentRegulatoryMapping ; dl:identifier "workload-execution-orchestration-dora" ; dl:mapsComponentType dl:WorkloadExecutionOrchestration ; dl:regulatoryContext inst:regulation-dora ; dl:mappingRationale "Workload execution and orchestration are a direct technical means for recording, testing, assessing, approving, implementing and verifying ICT changes in a controlled manner; change management still requires management approval and documented policy." ; dl:regulatoryRequirementReference "DORA Article 9(4)(e) — ICT change management" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2022/2554" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-workload-execution-orchestration-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "workload-execution-orchestration-nist-800-53" ; dl:mapsComponentType dl:WorkloadExecutionOrchestration ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Workload execution and orchestration are a direct technical means for controlling configuration changes to systems and workloads; CM-3 still requires organisational change boards, baselines and documentation." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 CM-3 — Configuration Change Control" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-workload-execution-orchestration-bcbs-239 a dl:ComponentRegulatoryMapping ; dl:identifier "workload-execution-orchestration-bcbs-239" ; dl:mapsComponentType dl:WorkloadExecutionOrchestration ; dl:regulatoryContext inst:regulation-bcbs-239 ; dl:mappingRationale "Workload execution and orchestration are a direct technical means for generating aggregate and up-to-date risk data in a timely manner under normal and stress conditions; BCBS 239 still expects accuracy, completeness and governance beyond scheduling alone." ; dl:regulatoryRequirementReference "BCBS 239 Principle 5 — Timeliness" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.bis.org/publ/bcbs239.htm"^^xsd:anyURI ; dl:sourceVersion "BCBS 239 (January 2013)" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-data-product-definition-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "data-product-definition-gdpr" ; dl:mapsComponentType dl:DataProductDefinition ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Data product definition is a direct design-time means for determining how personal data will be structured and processed, which Article 25 requires to integrate data-protection principles into the means of processing; a product specification is not itself a DPIA or lawful basis." ; dl:regulatoryRequirementReference "GDPR Article 25(1) — data protection by design at the determination of the means of processing" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-data-contract-definition-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "data-contract-definition-gdpr" ; dl:mapsComponentType dl:DataContractDefinition ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Data contract definition is a direct design-time means for constraining by default the amount, extent, storage period and accessibility of personal data processed for a purpose; a contract artefact is not automatically a complete Article 25 implementation." ; dl:regulatoryRequirementReference "GDPR Article 25(2) — data protection by default for amount, extent, storage and accessibility" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-semantic-description-iso-11179 a dl:ComponentRegulatoryMapping ; dl:identifier "semantic-description-iso-11179" ; dl:mapsComponentType dl:SemanticDescription ; dl:regulatoryContext inst:regulation-iso-11179 ; dl:mappingRationale "Semantic description is a direct technical means for registering data-element meanings, concepts and relationships in a metadata registry; ISO/IEC 11179 does not assert that any particular ontology product is required." ; dl:regulatoryRequirementReference "ISO/IEC 11179 family — metadata registry concepts for data-element semantics" ; dl:assertedBy "Mark McCalla" ; dl:authoritativeSource "https://www.iso.org/standard/78914.html"^^xsd:anyURI ; dl:sourceVersion "ISO/IEC 11179 (metadata registry family)" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
