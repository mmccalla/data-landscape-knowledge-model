# Curated regulatory-relevance mappings derived from the cited primary sources.
# These assertions identify design context; they do not prove compliance or legal sufficiency.
# Coverage is intentionally incomplete: blank components and omitted regulations are not backlog debt.

@prefix dl: <https://www.entropy-data.com/data-landscape/ontology/> .
@prefix inst: <https://www.entropy-data.com/data-landscape/instance/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

inst:component-regulatory-secure-read-access-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-gdpr" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Secure read access is a direct technical means for restricting who may access personal data and for supporting confidentiality controls; applicability and the appropriate measures remain context- and risk-dependent." ; dl:regulatoryRequirementReference "GDPR Article 32(1)(b), 32(2) and 32(4)" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-read-access-hipaa a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-hipaa" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-hipaa ; dl:mappingRationale "Secure read access is a direct technical means for the HIPAA Security Rule access-control standard that allows access to ePHI only by authorised persons." ; dl:regulatoryRequirementReference "45 CFR 164.312(a)(1) — Access control" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html"^^xsd:anyURI ; dl:sourceVersion "HIPAA Security Rule currently in effect" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-read-access-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "secure-read-access-nist-800-53" ; dl:mapsComponentType dl:SecureReadAccess ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Secure read access is a direct technical means for enforcing approved authorisations for logical access to information and system resources; selecting and configuring the policy remains an organisational control decision." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 AC-3 — Access Enforcement" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-gdpr" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Secure write access is a direct technical means for protecting personal data against unauthorised alteration and for supporting integrity controls; it is only one part of the required technical and organisational measures." ; dl:regulatoryRequirementReference "GDPR Article 32(1)(b) and 32(2)" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-hipaa a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-hipaa" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-hipaa ; dl:mappingRationale "Secure write access is a direct technical means for protecting ePHI from improper alteration or destruction under the HIPAA Security Rule integrity standard." ; dl:regulatoryRequirementReference "45 CFR 164.312(c)(1) — Integrity" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://www.hhs.gov/hipaa/for-professionals/compliance-enforcement/audit/protocol/index.html"^^xsd:anyURI ; dl:sourceVersion "HIPAA Audit Protocol, updated July 2018" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-secure-write-access-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "secure-write-access-nist-800-53" ; dl:mapsComponentType dl:SecureWriteAccess ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Secure write access is a direct technical means for detecting and protecting against unauthorised changes to information; integrity monitoring and write controls still require policy selection and operational evidence." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 SI-7 — Software, Firmware, and Information Integrity" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-validation-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "validation-and-contract-binding-nist-800-53" ; dl:mapsComponentType dl:ValidationAndContractBinding ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Validation and contract binding are a direct technical means for checking information inputs and handling invalid inputs predictably; a contract implementation must still select and enforce the applicable constraints." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 SI-10 — Information Input Validation" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-validation-bcbs-239 a dl:ComponentRegulatoryMapping ; dl:identifier "validation-and-contract-binding-bcbs-239" ; dl:mapsComponentType dl:ValidationAndContractBinding ; dl:regulatoryContext inst:regulation-bcbs-239 ; dl:mappingRationale "Validation and contract binding are a direct technical means for checking accuracy and integrity constraints on risk and reporting data; BCBS 239 still expects broader governance, aggregation and reporting controls beyond pipeline validation." ; dl:regulatoryRequirementReference "BCBS 239 Principle 3 — Accuracy and integrity" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://www.bis.org/publ/bcbs239.htm"^^xsd:anyURI ; dl:sourceVersion "BCBS 239 (January 2013)" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-gdpr a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-gdpr" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-gdpr ; dl:mappingRationale "Metadata registration is a direct technical means for capturing purposes, data categories, recipients, transfers, retention and security measures needed for records of processing; a catalogue record is not automatically a complete Article 30 record." ; dl:regulatoryRequirementReference "GDPR Article 30 — Records of processing activities" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ; dl:sourceVersion "Regulation (EU) 2016/679" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-iso-11179 a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-iso-11179" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-iso-11179 ; dl:mappingRationale "Metadata registration directly aligns with the ISO/IEC 11179 metadata-registry family, including registration of dataset metadata, provenance, quality, fitness and risk information." ; dl:regulatoryRequirementReference "ISO/IEC 11179-33:2023 — Metamodel for data set registration" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://www.iso.org/standard/81725.html"^^xsd:anyURI ; dl:sourceVersion "ISO/IEC 11179-33:2023" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-metadata-registration-bcbs-239 a dl:ComponentRegulatoryMapping ; dl:identifier "metadata-registration-bcbs-239" ; dl:mapsComponentType dl:MetadataRegistration ; dl:regulatoryContext inst:regulation-bcbs-239 ; dl:mappingRationale "Metadata registration is a direct technical means for documenting ownership, lineage, definitions and quality characteristics required by a coherent risk-data architecture; BCBS 239 does not prescribe a specific registry product." ; dl:regulatoryRequirementReference "BCBS 239 Principle 2 — Data architecture and IT infrastructure" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://www.bis.org/publ/bcbs239.htm"^^xsd:anyURI ; dl:sourceVersion "BCBS 239 (January 2013)" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
inst:component-regulatory-failure-isolation-nist-800-53 a dl:ComponentRegulatoryMapping ; dl:identifier "failure-isolation-nist-800-53" ; dl:mapsComponentType dl:FailureIsolation ; dl:regulatoryContext inst:regulation-nist-800-53 ; dl:mappingRationale "Failure isolation is a direct technical means for limiting the impact of predictable component failures and for supporting controlled failure handling; NIST SI-13 still requires organisational failure analysis and recovery planning beyond isolation alone." ; dl:regulatoryRequirementReference "NIST SP 800-53 Rev. 5 SI-13 — Predictable Failure Prevention" ; dl:assertedBy "Entropy Data" ; dl:authoritativeSource "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ; dl:sourceVersion "NIST SP 800-53 Revision 5" ; dl:mappingStatus "REVIEWED" ; dl:evidenceStatus "CURATED_REGULATORY_RELEVANCE" .
