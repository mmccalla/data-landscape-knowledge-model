inst:standard-substrait a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "substrait" ; skos:prefLabel "Substrait"@en-GB ; dl:fullName "Substrait" ; dl:inStandardCategory tax:standard-category-query ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "Substrait Project (independent; ASF-inspired PMC)" ; dl:statusStatement "Stable; growing adoption across query engines" ; dl:whyAStandard "Substrait is published as an open specification with protobuf-defined plan types, governed by an independent, ASF-inspired PMC. Multiple independent engines consume and produce Substrait plans, which is exactly the cross-vendor interchange contract that makes it a standard rather than a project." ; dl:isNiche true ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
