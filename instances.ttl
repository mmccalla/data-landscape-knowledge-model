inst:assessment-jms a dl:LandscapeAssessment ; dl:identifier "assessment-jms" ; dl:assessmentOf inst:standard-jms ; dl:hasJudgement tax:judgement-caution ; dl:judgementReason "Java-only messaging API; maintain if you have it, don't pick it new." ; dl:hasTier tax:tier-legacy ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-ftp a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "ftp" ; skos:prefLabel "FTP / SFTP"@en-GB ; dl:fullName "File Transfer Protocol / SSH File Transfer Protocol" ; dl:inStandardCategory tax:standard-category-interconnection ; dl:firstReleaseYear "1971"^^xsd:gYear ; dl:governanceStatement "IETF" ; dl:statusStatement "Stable; legacy but pervasive in B2B data exchange" ; dl:isNiche false ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-ftp a dl:LandscapeAssessment ; dl:identifier "assessment-ftp" ; dl:assessmentOf inst:standard-ftp ; dl:hasJudgement tax:judgement-caution ; dl:judgementReason "Unencrypted FTP is unsafe for new work; SFTP-only as a last resort when partners can't speak HTTP APIs." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-deltasharing a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "deltasharing" ; skos:prefLabel "Delta Sharing"@en-GB ; dl:fullName "Delta Sharing Protocol" ; dl:inStandardCategory tax:standard-category-interconnection ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "Linux Foundation (donated by Databricks)" ; dl:statusStatement "Stable; multi-vendor adoption" ; dl:whyAStandard "Delta Sharing is published as an open REST protocol specification under the Linux Foundation, with reference servers and clients across multiple languages and several independent implementations (Databricks, AWS, Azure, Power BI). The wire protocol is the standard surface — not the Databricks product." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-deltasharing a dl:LandscapeAssessment ; dl:identifier "assessment-deltasharing" ; dl:assessmentOf inst:standard-deltasharing ; dl:hasJudgement tax:judgement-situational ; dl:judgementReason "Cross-org sharing without copies; well-defined niche." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-dataframe a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "dataframe" ; skos:prefLabel "DataFrame API"@en-GB ; dl:fullName "Python Dataframe API Standard" ; dl:inStandardCategory tax:standard-category-in-memory-format ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "Consortium for Python Data API Standards (data-apis.org)" ; dl:statusStatement "Draft RFC; multi-vendor adoption underway" ; dl:isNiche false ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-dataframe a dl:LandscapeAssessment ; dl:identifier "assessment-dataframe" ; dl:assessmentOf inst:standard-dataframe ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Portable Python DataFrame spec; the way to write library code that runs on pandas, Polars, Modin, and cuDF." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-arrow a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "arrow" ; skos:prefLabel "Apache Arrow"@en-GB ; dl:fullName "Apache Arrow" ; dl:inStandardCategory tax:standard-category-in-memory-format ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; broadly adopted across the analytics stack" ; dl:whyAStandard "Arrow's columnar memory layout and IPC format are an open specification, not a library. DuckDB, Polars, pandas 2.x, Spark, and ADBC all align on the same in-memory representation, which is what enables zero-copy interchange across engines and languages. The format spec is the standard." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-arrow a dl:LandscapeAssessment ; dl:identifier "assessment-arrow" ; dl:assessmentOf inst:standard-arrow ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "In-memory columnar standard powering Flight, ADBC, DataFusion, Polars." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-spark a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "spark" ; skos:prefLabel "Spark"@en-GB ; dl:fullName "Apache Spark" ; dl:inStandardCategory tax:standard-category-processing ; dl:firstReleaseYear "2014"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; Spark 4.x current, 3.x widely deployed" ; dl:whyAStandard "Spark's DataFrame API and the Spark Connect protocol are the standard parts. Spark Connect publishes a gRPC contract that any Spark-compatible engine can serve, and the DataFrame API is what other engines (e.g. Databricks Connect, Apache Sedona) target. The interface, not the JVM runtime, is what makes Spark a standard." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-spark a dl:LandscapeAssessment ; dl:identifier "assessment-spark" ; dl:assessmentOf inst:standard-spark ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Default distributed batch+streaming engine." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-beam a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "beam" ; skos:prefLabel "Beam"@en-GB ; dl:fullName "Apache Beam" ; dl:inStandardCategory tax:standard-category-processing ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; multi-runner model spec" ; dl:whyAStandard "Beam's value is the model, not the runner. The Beam programming model and the portability framework (Fn API, Runner API) are an open specification that multiple runners implement. Pipelines move between Flink, Spark, and Dataflow without code changes precisely because all three implement the same Beam contract — making the model the standard surface tools and teams target." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-beam a dl:LandscapeAssessment ; dl:identifier "assessment-beam" ; dl:assessmentOf inst:standard-beam ; dl:hasJudgement tax:judgement-situational ; dl:judgementReason "Write once, run on Flink/Spark/Dataflow; right when runner portability matters." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-pandas a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "pandas" ; skos:prefLabel "Pandas"@en-GB ; dl:fullName "pandas" ; dl:inStandardCategory tax:standard-category-processing ; dl:firstReleaseYear "2008"^^xsd:gYear ; dl:governanceStatement "NumFOCUS (open source)" ; dl:statusStatement "Stable; the de-facto Python DataFrame API" ; dl:whyAStandard "The pandas Python API is the de-facto DataFrame interface other libraries deliberately mimic — Modin, cuDF, Dask, and many wrappers expose pandas-compatible surfaces precisely because users already know it. The API shape, not the implementation, is what makes pandas a standard reference." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-pandas a dl:LandscapeAssessment ; dl:identifier "assessment-pandas" ; dl:assessmentOf inst:standard-pandas ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Universal Python DataFrame; you don't choose it, you encounter it." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-ibis a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "ibis" ; skos:prefLabel "Ibis"@en-GB ; dl:fullName "Ibis" ; dl:inStandardCategory tax:standard-category-processing ; dl:firstReleaseYear "2015"^^xsd:gYear ; dl:governanceStatement "Ibis Project (open source)" ; dl:statusStatement "Stable; multi-backend" ; dl:whyAStandard "Ibis defines a backend-neutral DataFrame expression API, with a published backend protocol that 20+ engines implement. The API and the backend contract are the standard surface — Ibis is the rare project where the standardised \"interface\" is its whole reason to exist." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-ibis a dl:LandscapeAssessment ; dl:identifier "assessment-ibis" ; dl:assessmentOf inst:standard-ibis ; dl:hasJudgement tax:judgement-assess ; dl:judgementReason "Portable Python DataFrame compiling to many backends; trajectory strong, footprint small." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-sql-dml a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "sql-dml" ; skos:prefLabel "SQL DML"@en-GB ; dl:fullName "SQL Data Manipulation Language" ; dl:inStandardCategory tax:standard-category-processing ; dl:firstReleaseYear "1986"^^xsd:gYear ; dl:governanceStatement "ANSI / ISO/IEC 9075" ; dl:statusStatement "Stable since 1986; revised regularly (latest SQL:2023)" ; dl:whyAStandard "ISO/IEC 9075 specifies a portable DML core — CTEs (SQL:1999), window functions (SQL:2003), and MERGE (SQL:2003) — that every serious analytical engine implements. Transformations written against this core run on Snowflake, BigQuery, Databricks, DuckDB, Postgres, and Trino with minimal change. The standard surface, not any vendor's dialect, is what makes SQL the default processing language." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-sql-dml a dl:LandscapeAssessment ; dl:identifier "assessment-sql-dml" ; dl:assessmentOf inst:standard-sql-dml ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Portable transformation language across relational/lakehouse engines." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
