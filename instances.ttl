inst:standard-orc a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "orc" ; skos:prefLabel "ORC"@en-GB ; dl:fullName "Apache ORC (Optimized Row Columnar)" ; dl:inStandardCategory tax:standard-category-file-formats ; dl:firstReleaseYear "2013"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; mostly seen in Hive-era stacks" ; dl:whyAStandard "ORC's on-disk format is an open Apache spec with independent readers in Java, C++, and Rust. Hive, Spark, Trino, Presto and others read and write the same files because they target the format, not a single library. The file format is the standard surface." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
