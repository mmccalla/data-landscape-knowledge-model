inst:standard-dpds a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "dpds" ; skos:prefLabel "DPDS"@en-GB ; dl:fullName "Data Product Descriptor Specification" ; dl:inStandardCategory tax:standard-category-data-products ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "OpenDataMesh community" ; dl:statusStatement "Active; community-driven specification" ; dl:isNiche false ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
