inst:standard-avro a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "avro" ; skos:prefLabel "AVRO"@en-GB ; dl:fullName "Apache Avro" ; dl:inStandardCategory tax:standard-category-file-formats ; dl:firstReleaseYear "2009"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; standard in Kafka" ; dl:whyAStandard "The Avro container format and binary encoding are open specifications with independent implementations across Java, Python, Go, C++, and Rust. Kafka, Schema Registry, and most stream processors depend on the format spec, not on a particular Avro library — which is what makes it portable." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
