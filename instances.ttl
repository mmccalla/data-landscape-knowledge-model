inst:assessment-dprod a dl:LandscapeAssessment ; dl:identifier "assessment-dprod" ; dl:assessmentOf inst:standard-dprod ; dl:hasJudgement tax:judgement-assess ; dl:judgementReason "RDF/OWL data-product vocabulary; right only when your stack already lives in linked data." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-iceberg a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "iceberg" ; skos:prefLabel "Iceberg"@en-GB ; dl:fullName "Apache Iceberg" ; dl:inStandardCategory tax:standard-category-open-table-formats ; dl:firstReleaseYear "2017"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; effectively the winner of the table-format race" ; dl:whyAStandard "Iceberg's table-format specification — manifest files, metadata layout, snapshot semantics — is published openly and re-implemented by every major engine: Snowflake, Databricks, Trino, Spark, Dremio, DuckDB. The format itself is the standard; the original Netflix implementation is just one client of it." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-iceberg a dl:LandscapeAssessment ; dl:identifier "assessment-iceberg" ; dl:assessmentOf inst:standard-iceberg ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Default open table format for new lakes; multi-vendor catalog support and ASF governance." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-delta a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "delta" ; skos:prefLabel "Delta"@en-GB ; dl:fullName "Delta Lake" ; dl:inStandardCategory tax:standard-category-open-table-formats ; dl:firstReleaseYear "2019"^^xsd:gYear ; dl:governanceStatement "Linux Foundation (originally Databricks)" ; dl:statusStatement "Stable; widely deployed" ; dl:whyAStandard "The Delta transaction-log protocol is published as an open spec and implemented by readers and writers beyond Databricks — delta-rs, Trino, Flink, Spark. The standard surface is the protocol, not the Databricks runtime; that is what makes a Delta table portable across engines." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-delta a dl:LandscapeAssessment ; dl:identifier "assessment-delta" ; dl:assessmentOf inst:standard-delta ; dl:hasJudgement tax:judgement-situational ; dl:judgementReason "Reach-For if you're on Databricks; Situational elsewhere." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-hudi a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "hudi" ; skos:prefLabel "Hudi"@en-GB ; dl:fullName "Apache Hudi" ; dl:inStandardCategory tax:standard-category-open-table-formats ; dl:firstReleaseYear "2017"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; strong streaming/upsert focus" ; dl:whyAStandard "Hudi publishes its on-disk table format and timeline protocol as an open spec, and engines beyond the Hudi runtime (Spark, Flink, Trino, Presto) read and write it directly. The format is the standard part; the platform tooling is one implementation of it." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-hudi a dl:LandscapeAssessment ; dl:identifier "assessment-hudi" ; dl:assessmentOf inst:standard-hudi ; dl:hasJudgement tax:judgement-assess ; dl:judgementReason "Third-place table format; legitimate CDC-upsert use cases but lost the default slot." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-ducklake a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "ducklake" ; skos:prefLabel "DuckLake"@en-GB ; dl:fullName "DuckLake" ; dl:inStandardCategory tax:standard-category-catalog-apis ; dl:firstReleaseYear "2025"^^xsd:gYear ; dl:governanceStatement "DuckDB Labs (vendor-driven open source)" ; dl:statusStatement "Emerging; v1.0 production-ready (April 2026), adoption concentrated in the DuckDB ecosystem" ; dl:whyAStandard "DuckLake's catalog schema is published as an open SQL specification — any database that speaks SQL can host a DuckLake catalog. Listed on the de-facto criterion: the schema is the standard surface, even though DuckDB Labs governs it and adoption is still early." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-vendor-led ; dl:evidenceStatus "DIRECT_OBSERVATION" .
