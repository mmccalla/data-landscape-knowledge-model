inst:standard-lance a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "lance" ; skos:prefLabel "Lance"@en-GB ; dl:fullName "Lance" ; dl:inStandardCategory tax:standard-category-file-formats, tax:standard-category-open-table-formats ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "Lance community (independent open source, LF-inspired governance)" ; dl:statusStatement "Emerging; production use concentrated in AI/ML stacks" ; dl:whyAStandard "Lance's on-disk format is published as an open spec with independent Rust and Python implementations. LanceDB, DataFusion, DuckDB integrations, and downstream tools target the format itself rather than a single library — putting it on the de-facto standard track under an open, LF-style community governance model." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
