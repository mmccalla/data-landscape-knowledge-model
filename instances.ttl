inst:standard-unity-catalog a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "unity-catalog" ; skos:prefLabel "Unity Catalog"@en-GB ; dl:fullName "Unity Catalog" ; dl:inStandardCategory tax:standard-category-catalog-apis ; dl:firstReleaseYear "2024"^^xsd:gYear ; dl:governanceStatement "Linux Foundation (originally Databricks)" ; dl:statusStatement "Open-sourced 2024; growing ecosystem" ; dl:whyAStandard "Unity Catalog publishes a public REST API that other catalogs and engines can implement and consume. The API is the standard surface — that is what makes \"speaks Unity\" a portability claim rather than a Databricks lock-in. The reference implementation is open source under the Linux Foundation." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
