inst:assessment-http a dl:LandscapeAssessment ; dl:identifier "assessment-http" ; dl:assessmentOf inst:standard-http ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Universal application transport; nobody decides to use it." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-kafka a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "kafka" ; skos:prefLabel "Kafka"@en-GB ; dl:fullName "Apache Kafka" ; dl:inStandardCategory tax:standard-category-messaging ; dl:firstReleaseYear "2011"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; the de-facto streaming platform" ; dl:whyAStandard "The Kafka wire protocol is publicly documented and re-implemented by Redpanda, WarpStream, and AutoMQ — clients written for one server work against the others. The standard surface is the protocol, not the Apache Kafka broker; that is what lets producers and consumers stay portable across vendors." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-kafka a dl:LandscapeAssessment ; dl:identifier "assessment-kafka" ; dl:assessmentOf inst:standard-kafka ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "The streaming backbone; competitors challenge the implementation, not the category." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
