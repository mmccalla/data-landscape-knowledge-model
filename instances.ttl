inst:standard-parquet a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "parquet" ; skos:prefLabel "PARQUET"@en-GB ; dl:fullName "Apache Parquet" ; dl:inStandardCategory tax:standard-category-file-formats ; dl:firstReleaseYear "2013"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; the columnar default" ; dl:whyAStandard "Parquet's on-disk format is published as an open spec with independent reader/writer implementations in C++, Java, Rust, Go, and Python. Every analytics engine and lakehouse format depends on the format spec, not on a particular library. That makes the file format itself the standard." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
