inst:standard-hive-metastore a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "hive-metastore" ; skos:prefLabel "Hive Metastore"@en-GB ; dl:fullName "Apache Hive Metastore" ; dl:inStandardCategory tax:standard-category-catalog-apis ; dl:firstReleaseYear "2010"^^xsd:gYear ; dl:governanceStatement "Apache Software Foundation" ; dl:statusStatement "Stable; ubiquitous in lakehouse engines, slowly being replaced by Iceberg REST and Unity Catalog" ; dl:whyAStandard "The Hive Metastore Thrift API is publicly defined and re-implemented by every major lakehouse engine. \"Speaks the Hive Metastore API\" became the portability test for a generation of big-data tools — the API is the standard, independent of the original Hive server." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
