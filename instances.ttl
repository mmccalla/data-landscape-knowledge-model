inst:assessment-avro-schema a dl:LandscapeAssessment ; dl:identifier "assessment-avro-schema" ; dl:assessmentOf inst:standard-avro-schema ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Schema language for Kafka payloads; pairs with Schema Registry." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-protobuf a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "protobuf" ; skos:prefLabel "Protobuf"@en-GB ; dl:fullName "Protocol Buffers" ; dl:inStandardCategory tax:standard-category-schema ; dl:firstReleaseYear "2008"^^xsd:gYear ; dl:governanceStatement "Google (open source, vendor-driven)" ; dl:statusStatement "Stable; de-facto schema for binary RPC" ; dl:whyAStandard "The .proto language and the wire format are publicly specified, with compilers and runtimes for every major language. gRPC, Schema Registry, and countless internal RPC stacks depend on the format definition rather than Google's implementation. That is the standard surface, even though Google governs it." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-vendor-led ; dl:evidenceStatus "DIRECT_OBSERVATION" .
