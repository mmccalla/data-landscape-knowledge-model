inst:standard-dbt a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "dbt" ; skos:prefLabel "dbt"@en-GB ; dl:fullName "data build tool" ; dl:inStandardCategory tax:standard-category-processing ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "dbt Labs (vendor-driven open source)" ; dl:statusStatement "De-facto standard for analytics engineering; vendor-governed format" ; dl:whyAStandard "The dbt project artefacts — the manifest.json, the model YAML, the schema.yml tests — have become the interchange format for analytics engineering. SQLMesh, Lightdash, Elementary, dbt-osmosis and many other tools read or emit dbt's project structure rather than inventing their own. Quality checks declared in dbt are part of that surface. That makes the format itself the standard, even though dbt Labs governs it." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-vendor-led ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-dbt a dl:LandscapeAssessment ; dl:identifier "assessment-dbt" ; dl:assessmentOf inst:standard-dbt ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Analytics-engineering default: SQL-first models, tests, lineage." ; dl:hasTier tax:tier-vendor ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-great-expectations a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "great-expectations" ; skos:prefLabel "Great Expectations"@en-GB ; dl:fullName "Great Expectations" ; dl:inStandardCategory tax:standard-category-data-quality ; dl:firstReleaseYear "2018"^^xsd:gYear ; dl:governanceStatement "GX Labs (vendor-driven open source)" ; dl:statusStatement "Widely adopted; vendor-driven" ; dl:whyAStandard "The expectations DSL and the JSON validation-result schema GX defines have become the reference vocabulary for declarative data quality in Python. Other tools embed or interoperate with Great Expectations rather than reinvent the same primitives. The standard part is the expectation language and its result format — not the company behind it." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-vendor-led ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-great-expectations a dl:LandscapeAssessment ; dl:identifier "assessment-great-expectations" ; dl:assessmentOf inst:standard-great-expectations ; dl:hasJudgement tax:judgement-situational ; dl:judgementReason "Python-first DQ; powerful but heavy." ; dl:hasTier tax:tier-vendor ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-dbt-tests a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "dbt-tests" ; skos:prefLabel "dbt tests"@en-GB ; dl:fullName "dbt schema and data tests" ; dl:inStandardCategory tax:standard-category-data-quality ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "dbt Labs (vendor-driven open source)" ; dl:statusStatement "De-facto for analytics teams already on dbt" ; dl:whyAStandard "dbt's test definitions and the manifest entries they produce are what other DQ tools (Elementary, re_data, dbt-osmosis) read. The format is the standard surface even though dbt Labs governs it." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-vendor-led ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-dbt-tests a dl:LandscapeAssessment ; dl:identifier "assessment-dbt-tests" ; dl:assessmentOf inst:standard-dbt-tests ; dl:hasJudgement tax:judgement-situational ; dl:judgementReason "Right when your transformations already live in dbt; otherwise reach for a standalone DQ tool." ; dl:hasTier tax:tier-vendor ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-sodacl a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "sodacl" ; skos:prefLabel "SodaCL"@en-GB ; dl:fullName "Soda Checks Language" ; dl:inStandardCategory tax:standard-category-data-quality ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "Soda (vendor-driven open source)" ; dl:statusStatement "Widely adopted; vendor-driven" ; dl:whyAStandard "SodaCL is the YAML check language Soda publishes — and the part that other tools have standardised on. The Data Contract CLI delegates ODCS quality checks to SodaCL because expressing checks portably matters more than running them in Soda Cloud. The check syntax is the standard surface, even though Soda governs it." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-vendor-led ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-sodacl a dl:LandscapeAssessment ; dl:identifier "assessment-sodacl" ; dl:assessmentOf inst:standard-sodacl ; dl:hasJudgement tax:judgement-situational ; dl:judgementReason "YAML-first DQ; lighter than Great Expectations, smaller ecosystem." ; dl:hasTier tax:tier-vendor ; dl:evidenceStatus "DIRECT_OBSERVATION" .
