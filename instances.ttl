inst:standard-quack a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "quack" ; skos:prefLabel "Quack"@en-GB ; dl:fullName "Quack" ; dl:inStandardCategory tax:standard-category-database-connectivity ; dl:firstReleaseYear "2025"^^xsd:gYear ; dl:governanceStatement "DuckDB Labs (vendor-driven open source)" ; dl:statusStatement "Emerging; new client-server protocol from the DuckDB ecosystem" ; dl:whyAStandard "Quack is published as an open protocol specification by DuckDB Labs. Listed on the de-facto criterion: the wire format is the standard surface, even though governance sits with a single vendor and adoption is still concentrated in the DuckDB ecosystem." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-vendor-led ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:assessment-quack a dl:LandscapeAssessment ; dl:identifier "assessment-quack" ; dl:assessmentOf inst:standard-quack ; dl:hasJudgement tax:judgement-assess ; dl:judgementReason "DuckDB's new client-server protocol; promising but early — watch adoption beyond the DuckDB ecosystem." ; dl:hasTier tax:tier-emerging ; dl:evidenceStatus "DIRECT_OBSERVATION" .
