inst:standard-opa a dl:LandscapeEntry, dl:DataStandardLandscapeEntry ; dl:identifier "opa" ; skos:prefLabel "OPA"@en-GB ; dl:fullName "Open Policy Agent" ; dl:inStandardCategory tax:standard-category-policies ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "CNCF (Graduated)" ; dl:statusStatement "Stable; de-facto policy engine for cloud-native" ; dl:whyAStandard "Rego — the policy language OPA defines — has become the portable way to express authorization rules across cloud-native systems. Kubernetes admission control, service meshes, CI gates, and data-mesh governance all consume the same Rego policies. The language and the OPA evaluation API are the standard, with multiple compatible runtimes." ; dl:isNiche false ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
