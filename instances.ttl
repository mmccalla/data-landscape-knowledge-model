inst:assessment-cloudevents a dl:LandscapeAssessment ; dl:identifier "assessment-cloudevents" ; dl:assessmentOf inst:standard-cloudevents ; dl:hasJudgement tax:judgement-adopt ; dl:judgementReason "Default event envelope; HTTP/Kafka/AMQP/MQTT bindings all standardised." ; dl:hasTier tax:tier-stable ; dl:evidenceStatus "DIRECT_OBSERVATION" .
