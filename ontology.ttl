# Derived from Data Landscape and Data Landscape for Regulation.
# Harrer, S. (2026), Entropy Data, https://www.data-landscape.com/
# Upstream data is MIT-licensed; see ATTRIBUTION.md and LICENSE in this package.

@prefix dl: <https://polymathic.co.uk/data-landscape/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dl: a owl:Ontology ;
  dcterms:title "Data Landscape ontology"@en-GB ;
  dcterms:description "Schema-first ontology for entries in the Data Standard and Data Regulation landscapes, their classifications, editorial assessments and sourced mappings."@en-GB ;
  dcterms:source <https://www.data-landscape.com/>, <https://www.data-landscape.com/regulation.html> ;
  dcterms:license <https://opensource.org/licenses/MIT> ;
  dcterms:creator "Mark McCalla"@en-GB ;
  dcterms:rights "Catalogue data copyright (c) 2026 Entropy Data; derived model copyright (c) 2026 Mark McCalla."@en-GB ;
  owl:versionInfo "3.2.0" ; dcterms:created "2026-07-28"^^xsd:date ; dcterms:modified "2026-08-20"^^xsd:date .

dl:LandscapeEntry a owl:Class ; rdfs:label "Landscape entry"@en-GB ;
  rdfs:comment "An entry curated into one of the two Data Landscape catalogues. The class records landscape membership and does not assert that every entry is intrinsically a standard or a law."@en-GB .
dl:DataStandardLandscapeEntry a owl:Class ; rdfs:subClassOf dl:LandscapeEntry ; rdfs:label "Data Standard Landscape entry"@en-GB .
dl:DataRegulationLandscapeEntry a owl:Class ; rdfs:subClassOf dl:LandscapeEntry ; rdfs:label "Data Regulation Landscape entry"@en-GB .
dl:LandscapeAssessment a owl:Class ; rdfs:label "Landscape assessment"@en-GB ;
  rdfs:comment "A contextual editorial opinion about one Data Standard Landscape entry."@en-GB .
dl:SourcedMapping a owl:Class ; rdfs:label "Sourced mapping"@en-GB ;
  rdfs:comment "A mapping assertion with explicit provenance, version and status."@en-GB .
dl:ComplianceMapping a owl:Class ; rdfs:subClassOf dl:SourcedMapping ; rdfs:label "Compliance mapping"@en-GB ;
  rdfs:comment "A versioned, attributable assertion connecting two landscape entries. It does not itself assert that an organisation complies with a law."@en-GB .
dl:DataIngestionPattern a owl:Class ; rdfs:label "Data ingestion pattern"@en-GB .
dl:BatchFileIngestion a owl:Class ; rdfs:subClassOf dl:DataIngestionPattern ; rdfs:label "Batch file ingestion"@en-GB .
dl:APIPullIngestion a owl:Class ; rdfs:subClassOf dl:DataIngestionPattern ; rdfs:label "API pull ingestion"@en-GB .
dl:EventDrivenIngestion a owl:Class ; rdfs:subClassOf dl:DataIngestionPattern ; rdfs:label "Event-driven ingestion"@en-GB .
dl:DatabaseCDCIngestion a owl:Class ; rdfs:subClassOf dl:DataIngestionPattern ; rdfs:label "Database CDC ingestion"@en-GB .
dl:ObjectStoreReplication a owl:Class ; rdfs:subClassOf dl:DataIngestionPattern ; rdfs:label "Object-store replication"@en-GB .
dl:TableFormatStreaming a owl:Class ; rdfs:subClassOf dl:DataIngestionPattern ; rdfs:label "Table-format streaming"@en-GB .
dl:DataPipelineModule a owl:Class ; rdfs:label "Data pipeline module"@en-GB .
dl:DefineModule a owl:Class ; rdfs:subClassOf dl:DataPipelineModule ; rdfs:label "Define module"@en-GB .
dl:TriggerModule a owl:Class ; rdfs:subClassOf dl:DataPipelineModule ; rdfs:label "Trigger module"@en-GB .
dl:OrchestrateModule a owl:Class ; rdfs:subClassOf dl:DataPipelineModule ; rdfs:label "Orchestrate module"@en-GB .
dl:GovernModule a owl:Class ; rdfs:subClassOf dl:DataPipelineModule ; rdfs:label "Govern module"@en-GB .
dl:StoreModule a owl:Class ; rdfs:subClassOf dl:DataPipelineModule ; rdfs:label "Store module"@en-GB .
dl:DataPipelineComponent a owl:Class ; rdfs:label "Data pipeline component"@en-GB .
dl:DataProductDefinition a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Data product definition"@en-GB .
dl:DataContractDefinition a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Data contract definition"@en-GB .
dl:SemanticDescription a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Semantic description"@en-GB .
dl:TriggerInvocation a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Trigger invocation"@en-GB .
dl:WorkloadPlanning a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Workload planning"@en-GB .
dl:SecureReadAccess a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Secure read access"@en-GB .
dl:SourceConnectivity a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Source connectivity"@en-GB .
dl:WorkloadExecutionOrchestration a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Workload execution/orchestration"@en-GB .
dl:LineageEmission a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Lineage emission"@en-GB ;
  rdfs:comment "Operational emission of job, run and dataset lineage events during pipeline execution. Distinct from metadata registration in Store."@en-GB .
dl:StateAndIdempotency a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "State and idempotency"@en-GB .
dl:ValidationAndContractBinding a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Validation and contract binding"@en-GB .
dl:FailureIsolation a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Failure isolation"@en-GB .
dl:SecureWriteAccess a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Secure write access"@en-GB .
dl:MetadataRegistration a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Metadata registration"@en-GB .
dl:StoreWriteDataProduct a owl:Class ; rdfs:subClassOf dl:DataPipelineComponent ; rdfs:label "Store/write data product"@en-GB .
dl:BatchFileIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:DefineModule ] .
dl:BatchFileIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:TriggerModule ] .
dl:BatchFileIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:OrchestrateModule ] .
dl:BatchFileIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:GovernModule ] .
dl:BatchFileIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:StoreModule ] .
dl:APIPullIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:DefineModule ] .
dl:APIPullIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:TriggerModule ] .
dl:APIPullIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:OrchestrateModule ] .
dl:APIPullIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:GovernModule ] .
dl:APIPullIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:StoreModule ] .
dl:EventDrivenIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:DefineModule ] .
dl:EventDrivenIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:TriggerModule ] .
dl:EventDrivenIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:OrchestrateModule ] .
dl:EventDrivenIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:GovernModule ] .
dl:EventDrivenIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:StoreModule ] .
dl:DatabaseCDCIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:DefineModule ] .
dl:DatabaseCDCIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:TriggerModule ] .
dl:DatabaseCDCIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:OrchestrateModule ] .
dl:DatabaseCDCIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:GovernModule ] .
dl:DatabaseCDCIngestion rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:StoreModule ] .
dl:ObjectStoreReplication rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:DefineModule ] .
dl:ObjectStoreReplication rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:TriggerModule ] .
dl:ObjectStoreReplication rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:OrchestrateModule ] .
dl:ObjectStoreReplication rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:GovernModule ] .
dl:ObjectStoreReplication rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:StoreModule ] .
dl:TableFormatStreaming rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:DefineModule ] .
dl:TableFormatStreaming rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:TriggerModule ] .
dl:TableFormatStreaming rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:OrchestrateModule ] .
dl:TableFormatStreaming rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:GovernModule ] .
dl:TableFormatStreaming rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasModule ; owl:someValuesFrom dl:StoreModule ] .
dl:DefineModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:DataProductDefinition ] .
dl:DefineModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:DataContractDefinition ] .
dl:DefineModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:SemanticDescription ] .
dl:TriggerModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:TriggerInvocation ] .
dl:TriggerModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:WorkloadPlanning ] .
dl:OrchestrateModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:SecureReadAccess ] .
dl:OrchestrateModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:SourceConnectivity ] .
dl:OrchestrateModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:WorkloadExecutionOrchestration ] .
dl:OrchestrateModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:LineageEmission ] .
dl:GovernModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:StateAndIdempotency ] .
dl:GovernModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:ValidationAndContractBinding ] .
dl:GovernModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:FailureIsolation ] .
dl:StoreModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:SecureWriteAccess ] .
dl:StoreModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:MetadataRegistration ] .
dl:StoreModule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty dl:hasComponent ; owl:someValuesFrom dl:StoreWriteDataProduct ] .
dl:ComponentMapping a owl:Class ; rdfs:subClassOf dl:SourcedMapping ; rdfs:label "Component mapping"@en-GB .
dl:ComponentImplementationMapping a owl:Class ; rdfs:subClassOf dl:ComponentMapping ; rdfs:label "Component implementation mapping"@en-GB ;
  rdfs:comment "A curated design-time mapping from a pipeline component type to a landscape entry that can implement or support it."@en-GB .
dl:ComponentRegulatoryMapping a owl:Class ; rdfs:subClassOf dl:ComponentMapping ; rdfs:label "Component regulatory mapping"@en-GB ;
  rdfs:comment "A curated design-time assertion that a pipeline component type is relevant to a cited requirement in a Data Regulation Landscape entry. It does not assert compliance or legal sufficiency."@en-GB .
dl:DataProduct a owl:Class ; rdfs:label "Data product"@en-GB ;
  rdfs:comment "A curated published data product under inspection. Orthogonal to pipeline component types: personal-data posture and industry vertical classify the product for design inspection. Not a legal determination of applicability."@en-GB .
dl:ProductMapping a owl:Class ; rdfs:subClassOf dl:SourcedMapping ; rdfs:label "Product mapping"@en-GB ;
  rdfs:comment "A curated, attributable assertion linking a data product to a landscape entry that creators should consider. It does not assert compliance, completeness, or legal applicability."@en-GB .
dl:ProductStandardRelevance a owl:Class ; rdfs:subClassOf dl:ProductMapping ; rdfs:label "Product standard relevance"@en-GB ;
  rdfs:comment "A curated assertion linking a named data product to a Data Standard Landscape entry. Absent hasMappingRelation means the standard is worth considering; hasMappingRelation no-coverage records an explicit non-link rather than silence."@en-GB .
dl:ProductRegulatoryRelevance a owl:Class ; rdfs:subClassOf dl:ProductMapping ; rdfs:label "Product regulatory relevance"@en-GB ;
  rdfs:comment "A curated assertion that a Data Regulation Landscape entry is worth considering when designing the named data product. It is not a determination that the regulation applies."@en-GB .

dl:Attestation a owl:Class ; rdfs:label "Attestation"@en-GB .
dl:Actor a owl:Class ; rdfs:label "Actor"@en-GB .
dl:SystemActor a owl:Class ; rdfs:subClassOf dl:Actor ; rdfs:label "System actor"@en-GB .
dl:AgentActor a owl:Class ; rdfs:subClassOf dl:Actor ; rdfs:label "Agent actor"@en-GB .
dl:HumanActor a owl:Class ; rdfs:subClassOf dl:Actor ; rdfs:label "Human actor"@en-GB .
dl:Action a owl:Class ; rdfs:label "Action"@en-GB .
dl:Risk a owl:Class ; rdfs:label "Risk"@en-GB .
dl:Control a owl:Class ; rdfs:label "Control"@en-GB .
dl:ControlEvidence a owl:Class ; rdfs:label "Control evidence"@en-GB .
dl:Category a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Category concept"@en-GB .
dl:StandardCategory a owl:Class ; rdfs:subClassOf dl:Category ; rdfs:label "Data Standard Landscape category"@en-GB .
dl:RegulationCategory a owl:Class ; rdfs:subClassOf dl:Category ; rdfs:label "Data Regulation Landscape category"@en-GB .
dl:Judgement a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Judgement concept"@en-GB .
dl:Tier a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Tier concept"@en-GB .
dl:GovernanceType a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Governance type concept"@en-GB ;
  rdfs:comment "The principal authority or stewardship arrangement under which an entry is established and maintained."@en-GB .
dl:Jurisdiction a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Jurisdiction concept"@en-GB .
dl:MappingRelation a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Mapping relation concept"@en-GB .
dl:MappingAuthorityType a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Mapping authority type concept"@en-GB .
dl:PersonalDataPosture a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Personal-data posture concept"@en-GB ;
  rdfs:comment "Whether a curated data product is modelled as containing personal data (PII) or not (NO_PII). A design-inspection aid, not a legal determination."@en-GB .
dl:IndustryVertical a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Industry vertical concept"@en-GB ;
  rdfs:comment "The primary industry stance of a curated data product. Selects which sector-shaped regulatory neighbourhood is relevant to inspect."@en-GB .

dl:identifier a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "identifier"@en-GB .
dl:fullName a owl:DatatypeProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range xsd:string ; rdfs:label "full name"@en-GB .
dl:inStandardCategory a owl:ObjectProperty ; rdfs:domain dl:DataStandardLandscapeEntry ; rdfs:range dl:StandardCategory ; rdfs:label "in Data Standard Landscape category"@en-GB .
dl:inRegulationCategory a owl:ObjectProperty ; rdfs:domain dl:DataRegulationLandscapeEntry ; rdfs:range dl:RegulationCategory ; rdfs:label "in Data Regulation Landscape category"@en-GB .
dl:assessmentOf a owl:ObjectProperty ; rdfs:domain dl:LandscapeAssessment ; rdfs:range dl:DataStandardLandscapeEntry ; rdfs:label "assessment of"@en-GB .
dl:hasJudgement a owl:ObjectProperty ; rdfs:domain dl:LandscapeAssessment ; rdfs:range dl:Judgement ; rdfs:label "has judgement"@en-GB .
dl:judgementReason a owl:DatatypeProperty ; rdfs:domain dl:LandscapeAssessment ; rdfs:range xsd:string ; rdfs:label "judgement reason"@en-GB .
dl:hasTier a owl:ObjectProperty ; rdfs:domain dl:LandscapeAssessment ; rdfs:range dl:Tier ; rdfs:label "has tier"@en-GB .
dl:hasGovernanceType a owl:ObjectProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range dl:GovernanceType ; rdfs:label "has governance type"@en-GB .
dl:governanceStatement a owl:DatatypeProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range xsd:string ; rdfs:label "governance statement"@en-GB .
dl:statusStatement a owl:DatatypeProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range xsd:string ; rdfs:label "status statement"@en-GB .
dl:firstReleaseYear a owl:DatatypeProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range xsd:gYear ; rdfs:label "first release year"@en-GB .
dl:description a owl:DatatypeProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range xsd:string ; rdfs:label "description"@en-GB .
dl:referenceLink a owl:DatatypeProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range xsd:anyURI ; rdfs:label "reference link"@en-GB .
dl:sourceJurisdictionLabel a owl:DatatypeProperty ; rdfs:domain dl:DataRegulationLandscapeEntry ; rdfs:range xsd:string ; rdfs:label "source jurisdiction label"@en-GB .
dl:appliesIn a owl:ObjectProperty ; rdfs:domain dl:DataRegulationLandscapeEntry ; rdfs:range dl:Jurisdiction ; rdfs:label "applies in or is relevant in"@en-GB .
dl:whyAStandard a owl:DatatypeProperty ; rdfs:domain dl:DataStandardLandscapeEntry ; rdfs:range xsd:string ; rdfs:label "why a standard"@en-GB .
dl:isNiche a owl:DatatypeProperty ; rdfs:domain dl:DataStandardLandscapeEntry ; rdfs:range xsd:boolean ; rdfs:label "is niche"@en-GB .
dl:describesSameResourceAs a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain dl:LandscapeEntry ; rdfs:range dl:LandscapeEntry ; rdfs:label "describes same resource as"@en-GB ;
  rdfs:comment "Links two source-specific landscape entries that describe the same underlying resource without merging their landscape-specific statements."@en-GB .

dl:mappingSourceEntry a owl:ObjectProperty ; rdfs:domain dl:ComplianceMapping ; rdfs:range dl:LandscapeEntry ; rdfs:label "mapping source entry"@en-GB .
dl:mappingTargetEntry a owl:ObjectProperty ; rdfs:domain dl:ComplianceMapping ; rdfs:range dl:LandscapeEntry ; rdfs:label "mapping target entry"@en-GB .
dl:hasMappingRelation a owl:ObjectProperty ; rdfs:domain dl:SourcedMapping ; rdfs:range dl:MappingRelation ; rdfs:label "has mapping relation"@en-GB ;
  rdfs:comment "Qualifies a sourced mapping. Required on ComplianceMapping; optional on ProductStandardRelevance to record explicit non-coverage."@en-GB .
dl:hasMappingAuthorityType a owl:ObjectProperty ; rdfs:domain dl:ComplianceMapping ; rdfs:range dl:MappingAuthorityType ; rdfs:label "has mapping authority type"@en-GB .
dl:assertedBy a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "asserted by"@en-GB ;
  rdfs:comment "The party asserting a sourced mapping or a curated data-product typology statement."@en-GB .
dl:authoritativeSource a owl:DatatypeProperty ; rdfs:domain dl:SourcedMapping ; rdfs:range xsd:anyURI ; rdfs:label "authoritative source"@en-GB .
dl:sourceVersion a owl:DatatypeProperty ; rdfs:domain dl:SourcedMapping ; rdfs:range xsd:string ; rdfs:label "source version"@en-GB .
dl:mappingStatus a owl:DatatypeProperty ; rdfs:domain dl:SourcedMapping ; rdfs:range xsd:string ; rdfs:label "mapping status"@en-GB .
dl:evidenceStatus a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "evidence status"@en-GB ;
  rdfs:comment "Distinguishes direct source data, deterministic normalisation and assertions from separately identified official sources."@en-GB .

dl:hasModule a owl:ObjectProperty ; rdfs:domain dl:DataIngestionPattern ; rdfs:range dl:DataPipelineModule ; rdfs:label "has module"@en-GB .
dl:hasComponent a owl:ObjectProperty ; rdfs:domain dl:DataPipelineModule ; rdfs:range dl:DataPipelineComponent ; rdfs:label "has component"@en-GB .
dl:mapsComponentType a owl:ObjectProperty ; rdfs:domain dl:ComponentMapping ; rdfs:range owl:Class ; rdfs:label "maps component type"@en-GB .
dl:implementationOption a owl:ObjectProperty ; rdfs:domain dl:ComponentImplementationMapping ; rdfs:range dl:DataStandardLandscapeEntry ; rdfs:label "implementation option"@en-GB .
dl:mappingRationale a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "mapping rationale"@en-GB ;
  rdfs:comment "Human-readable rationale for a component or product mapping assertion."@en-GB .
dl:regulatoryContext a owl:ObjectProperty ; rdfs:domain dl:ComponentRegulatoryMapping ; rdfs:range dl:DataRegulationLandscapeEntry ; rdfs:label "regulatory context"@en-GB .
dl:regulatoryRequirementReference a owl:DatatypeProperty ; rdfs:domain dl:ComponentRegulatoryMapping ; rdfs:range xsd:string ; rdfs:label "regulatory requirement reference"@en-GB .

dl:hasPersonalDataPosture a owl:ObjectProperty ; rdfs:domain dl:DataProduct ; rdfs:range dl:PersonalDataPosture ; rdfs:label "has personal-data posture"@en-GB .
dl:inIndustryVertical a owl:ObjectProperty ; rdfs:domain dl:DataProduct ; rdfs:range dl:IndustryVertical ; rdfs:label "in industry vertical"@en-GB .
dl:hasDesignJurisdiction a owl:ObjectProperty ; rdfs:domain dl:DataProduct ; rdfs:range dl:Jurisdiction ; rdfs:label "has design jurisdiction"@en-GB ;
  rdfs:comment "Optional multi-valued design prompt pointing readers at regulation APPLIES_IN neighbourhoods. Not a determination that any regulation applies to the product or organisation."@en-GB .
dl:productRationale a owl:DatatypeProperty ; rdfs:domain dl:DataProduct ; rdfs:range xsd:string ; rdfs:label "product rationale"@en-GB ;
  rdfs:comment "Short note explaining why this curated product example exists and what it is intended to illustrate."@en-GB .
dl:forDataProduct a owl:ObjectProperty ; rdfs:domain dl:ProductMapping ; rdfs:range dl:DataProduct ; rdfs:label "for data product"@en-GB .
dl:considersStandard a owl:ObjectProperty ; rdfs:domain dl:ProductStandardRelevance ; rdfs:range dl:DataStandardLandscapeEntry ; rdfs:label "considers standard"@en-GB ;
  rdfs:comment "Links a product-standard relevance assertion to the Data Standard Landscape entry the assertion concerns. When hasMappingRelation is no-coverage, the entry is the standard that is explicitly not covering the product example."@en-GB .
dl:considersRegulation a owl:ObjectProperty ; rdfs:domain dl:ProductRegulatoryRelevance ; rdfs:range dl:DataRegulationLandscapeEntry ; rdfs:label "considers regulation"@en-GB ;
  rdfs:comment "Links a product-regulatory relevance assertion to the Data Regulation Landscape entry that should be considered. Not a claim of applicability or compliance."@en-GB .

dl:attestationId a owl:DatatypeProperty ; rdfs:domain dl:Attestation ; rdfs:range xsd:string ; rdfs:label "attestation identifier"@en-GB .
dl:pipelineId a owl:DatatypeProperty ; rdfs:domain dl:Attestation ; rdfs:range xsd:string ; rdfs:label "pipeline identifier"@en-GB .
dl:moduleId a owl:DatatypeProperty ; rdfs:domain dl:Attestation ; rdfs:range xsd:string ; rdfs:label "module identifier"@en-GB .
dl:componentId a owl:DatatypeProperty ; rdfs:domain dl:Attestation ; rdfs:range xsd:string ; rdfs:label "component identifier"@en-GB .
dl:attestedAt a owl:DatatypeProperty ; rdfs:domain dl:Attestation ; rdfs:range xsd:dateTime ; rdfs:label "attested at"@en-GB .
dl:performedBy a owl:ObjectProperty ; rdfs:domain dl:Attestation ; rdfs:range dl:Actor ; rdfs:label "performed by"@en-GB .
dl:recordsAction a owl:ObjectProperty ; rdfs:domain dl:Attestation ; rdfs:range dl:Action ; rdfs:label "records action"@en-GB .
dl:recordsRisk a owl:ObjectProperty ; rdfs:domain dl:Attestation ; rdfs:range dl:Risk ; rdfs:label "records risk"@en-GB .
dl:recordsControl a owl:ObjectProperty ; rdfs:domain dl:Attestation ; rdfs:range dl:Control ; rdfs:label "records control"@en-GB .
dl:recordsEvidence a owl:ObjectProperty ; rdfs:domain dl:Attestation ; rdfs:range dl:ControlEvidence ; rdfs:label "records evidence"@en-GB .
