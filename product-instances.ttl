# --- Products ---

inst:product-retail-stock-data-product a dl:DataProduct ;
  dl:identifier "retail-stock-data-product" ;
  skos:prefLabel "Retail Stock Data Product"@en-GB ;
  dl:hasPersonalDataPosture tax:personal-data-posture-no-pii ;
  dl:inIndustryVertical tax:industry-vertical-retail ;
  dl:hasDesignJurisdiction tax:jurisdiction-global ;
  dl:assertedBy "Mark McCalla" ;
  dl:evidenceStatus "CURATED_PRODUCT_EXAMPLE" ;
  dl:productRationale "Curated retail stock / catalogue product example (inspired by Entropy Data's shelf-warmers demo). Marked no PII so the regulatory consideration set stays thin on purpose. OpenLineage and Iceberg are explicit no-coverage mappings: this example does not adopt lineage emission, and the demo product is a Snowflake table rather than an Iceberg table (Snowflake is not a landscape standard entry)." .

inst:product-banking-customer-data-product a dl:DataProduct ;
  dl:identifier "banking-customer-data-product" ;
  skos:prefLabel "Banking Customer Data Product"@en-GB ;
  dl:hasPersonalDataPosture tax:personal-data-posture-pii ;
  dl:inIndustryVertical tax:industry-vertical-banking ;
  dl:hasDesignJurisdiction tax:jurisdiction-uk ;
  dl:hasDesignJurisdiction tax:jurisdiction-eu ;
  dl:assertedBy "Mark McCalla" ;
  dl:evidenceStatus "CURATED_PRODUCT_EXAMPLE" ;
  dl:productRationale "Curated banking customer data product for UK/EU financial-services design inspection. Not a client artefact. Personal data and banking vertical surface GDPR and DORA as considerations; this does not assert that either instrument applies to a given organisation." .

inst:product-health-customer-data-product a dl:DataProduct ;
  dl:identifier "health-customer-data-product" ;
  skos:prefLabel "Health Customer Data Product"@en-GB ;
  dl:hasPersonalDataPosture tax:personal-data-posture-pii ;
  dl:inIndustryVertical tax:industry-vertical-health ;
  dl:hasDesignJurisdiction tax:jurisdiction-us ;
  dl:assertedBy "Mark McCalla" ;
  dl:evidenceStatus "CURATED_PRODUCT_EXAMPLE" ;
  dl:productRationale "Curated health customer / patient-facing data product for design inspection across US care settings. Design jurisdiction is United States so HIPAA is an appropriate consideration prompt; this does not assert applicability for a given provider." .

# --- Retail stock: standards to consider ---

inst:product-standard-retail-stock-odps a dl:ProductStandardRelevance ;
  dl:identifier "retail-stock-odps" ;
  dl:forDataProduct inst:product-retail-stock-data-product ;
  dl:considersStandard inst:standard-odps ;
  dl:mappingRationale "ODPS is the product-definition standard to consider when publishing a retail stock data product with explicit product metadata." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://github.com/bitol-io/open-data-product-standard"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

inst:product-standard-retail-stock-odcs a dl:ProductStandardRelevance ;
  dl:identifier "retail-stock-odcs" ;
  dl:forDataProduct inst:product-retail-stock-data-product ;
  dl:considersStandard inst:standard-odcs ;
  dl:mappingRationale "ODCS is the data-contract standard to consider for schema, quality and delivery expectations on a retail stock product interface." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://bitol-io.github.io/open-data-contract-standard/latest/"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

inst:product-standard-retail-stock-dbt a dl:ProductStandardRelevance ;
  dl:identifier "retail-stock-dbt" ;
  dl:forDataProduct inst:product-retail-stock-data-product ;
  dl:considersStandard inst:standard-dbt ;
  dl:mappingRationale "dbt is a common transformation and test tooling option to consider when building the retail stock product's analytical pipeline." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://www.getdbt.com"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

inst:product-standard-retail-stock-openlineage a dl:ProductStandardRelevance ;
  dl:identifier "retail-stock-openlineage" ;
  dl:forDataProduct inst:product-retail-stock-data-product ;
  dl:considersStandard inst:standard-openlineage ;
  dl:hasMappingRelation tax:mapping-relation-no-coverage ;
  dl:mappingRationale "OpenLineage is an ADOPT lineage-emission option on the Orchestrate module, but this curated retail stock example deliberately does not adopt lineage emission; the non-link is explicit rather than silent." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://openlineage.io/docs/spec/object-model/"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

inst:product-standard-retail-stock-iceberg a dl:ProductStandardRelevance ;
  dl:identifier "retail-stock-iceberg" ;
  dl:forDataProduct inst:product-retail-stock-data-product ;
  dl:considersStandard inst:standard-iceberg ;
  dl:hasMappingRelation tax:mapping-relation-no-coverage ;
  dl:mappingRationale "Iceberg is a store/write option in the pipeline typology, but the Entropy shelf-warmers-inspired demo product is a Snowflake table rather than an Iceberg table; Snowflake is not minted as a landscape standard here." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://iceberg.apache.org"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

# --- Banking customer: standards and regulations to consider ---

inst:product-standard-banking-customer-odps a dl:ProductStandardRelevance ;
  dl:identifier "banking-customer-odps" ;
  dl:forDataProduct inst:product-banking-customer-data-product ;
  dl:considersStandard inst:standard-odps ;
  dl:mappingRationale "ODPS is the product-definition standard to consider when publishing a banking customer data product." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://github.com/bitol-io/open-data-product-standard"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

inst:product-standard-banking-customer-odcs a dl:ProductStandardRelevance ;
  dl:identifier "banking-customer-odcs" ;
  dl:forDataProduct inst:product-banking-customer-data-product ;
  dl:considersStandard inst:standard-odcs ;
  dl:mappingRationale "ODCS is the data-contract standard to consider for enforceable interface and quality expectations on customer data products." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://bitol-io.github.io/open-data-contract-standard/latest/"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

inst:product-standard-banking-customer-openlineage a dl:ProductStandardRelevance ;
  dl:identifier "banking-customer-openlineage" ;
  dl:forDataProduct inst:product-banking-customer-data-product ;
  dl:considersStandard inst:standard-openlineage ;
  dl:mappingRationale "OpenLineage is worth considering for a banking customer product so operational job, run and dataset lineage can support ICT resilience and change-impact analysis; selection remains optional and does not assert DORA compliance." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://openlineage.io/docs/spec/object-model/"^^xsd:anyURI ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_STANDARD_RELEVANCE" .

inst:product-regulatory-banking-customer-gdpr a dl:ProductRegulatoryRelevance ;
  dl:identifier "banking-customer-gdpr" ;
  dl:forDataProduct inst:product-banking-customer-data-product ;
  dl:considersRegulation inst:regulation-gdpr ;
  dl:mappingRationale "A banking customer data product that holds personal data should prompt GDPR consideration for lawful basis, purpose limitation, subject rights and records of processing. This is a design prompt, not a finding of applicability." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2016/679/oj"^^xsd:anyURI ;
  dl:sourceVersion "Regulation (EU) 2016/679" ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_REGULATORY_RELEVANCE" .

inst:product-regulatory-banking-customer-dora a dl:ProductRegulatoryRelevance ;
  dl:identifier "banking-customer-dora" ;
  dl:forDataProduct inst:product-banking-customer-data-product ;
  dl:considersRegulation inst:regulation-dora ;
  dl:mappingRationale "A banking customer data product in an EU financial entity context should prompt DORA consideration for ICT risk, access control and third-party dependencies. This is a design prompt, not a finding of applicability." ;
  dl:assertedBy "Mark McCalla" ;
  dl:authoritativeSource "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI ;
  dl:sourceVersion "Regulation (EU) 2022/2554" ;
  dl:mappingStatus "REVIEWED" ;
  dl:evidenceStatus "CURATED_PRODUCT_REGULATORY_RELEVANCE" .

