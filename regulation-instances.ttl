@prefix inst: <https://www.entropy-data.com/data-landscape/instance/> .
@prefix tax: <https://www.entropy-data.com/data-landscape/taxonomy/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

inst:regulation-gdpr a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "gdpr" ; skos:prefLabel "GDPR"@en-GB ; dl:fullName "General Data Protection Regulation" ; dl:inRegulationCategory tax:regulation-category-eu-data-and-ai-acts ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "European Union" ; dl:statusStatement "Regulation (EU) 2016/679; applicable since May 2018" ; dl:description "The EU's personal data regime: lawful basis, purpose limitation, data minimisation, data subject rights, records of processing, transfer rules, and breach notification within 72 hours.", "For a data platform it is the source of most catalogue metadata obligations you cannot avoid: what personal data you hold, why you hold it, who it goes to, and how long you keep it. ISO/IEC 27701 and the EU Cloud Code of Conduct are the usual ways of evidencing it." ; dl:referenceLink "https://eur-lex.europa.eu/eli/reg/2016/679/oj"^^xsd:anyURI, "https://www.edpb.europa.eu/our-work-tools/general-guidance/guidelines-recommendations-best-practices_en"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-eu-ai-act a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "eu-ai-act" ; skos:prefLabel "EU AI Act"@en-GB ; dl:fullName "Artificial Intelligence Act" ; dl:inRegulationCategory tax:regulation-category-eu-data-and-ai-acts ; dl:firstReleaseYear "2024"^^xsd:gYear ; dl:governanceStatement "European Union" ; dl:statusStatement "Regulation (EU) 2024/1689; prohibitions since February 2025, general-purpose AI rules since August 2025, high-risk obligations from 2027" ; dl:description "A risk-tiered regime for AI systems: prohibited practices, obligations for high-risk systems (risk management, data governance, technical documentation, logging, human oversight, accuracy and robustness), transparency duties, and a separate track for general-purpose AI models.", "Its data governance article is the one that lands on data teams: training, validation and test data sets must be relevant, sufficiently representative, and as far as possible free of errors and complete. ISO/IEC 42001 and the forthcoming CEN-CENELEC standards are how conformity gets demonstrated." ; dl:referenceLink "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"^^xsd:anyURI, "https://digital-strategy.ec.europa.eu/en/policies/regulatory-framework-ai"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-eu-data-act a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "eu-data-act" ; skos:prefLabel "Data Act"@en-GB ; dl:fullName "EU Data Act" ; dl:inRegulationCategory tax:regulation-category-eu-data-and-ai-acts ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "European Union" ; dl:statusStatement "Regulation (EU) 2023/2854; in force January 2024, applicable since 12 September 2025" ; dl:description "Rules on access to and use of data generated by connected products and related services: users get access to the data their devices produce and can direct it to third parties, with contractual fairness rules and safeguards against unlawful international access.", "It also mandates cloud switching and interoperability, removing egress charges over time and requiring providers to support portability. That makes open formats and portable contracts a legal argument, not only an architectural preference." ; dl:referenceLink "https://eur-lex.europa.eu/eli/reg/2023/2854/oj"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-eu-dga a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "eu-dga" ; skos:prefLabel "DGA"@en-GB ; dl:fullName "Data Governance Act" ; dl:inRegulationCategory tax:regulation-category-eu-data-and-ai-acts ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "European Union" ; dl:statusStatement "Regulation (EU) 2022/868; applicable since September 2023" ; dl:description "The framework for data sharing across the EU: re-use of protected public sector data, a notification regime for data intermediation services, and rules for recognised data altruism organisations.", "It is the legal scaffolding under the European data spaces, and the reason the Dataspace Protocol, Gaia-X and the DSSC Blueprint exist as concrete implementations rather than position papers." ; dl:referenceLink "https://eur-lex.europa.eu/eli/reg/2022/868/oj"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-nis2 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "nis2" ; skos:prefLabel "NIS2"@en-GB ; dl:fullName "Network and Information Security Directive 2" ; dl:inRegulationCategory tax:regulation-category-eu-resilience-and-security-acts ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "European Union" ; dl:statusStatement "Directive (EU) 2022/2555; national transposition was due October 2024, and several member states ran late" ; dl:description "Cybersecurity risk management and incident reporting duties for essential and important entities across energy, transport, health, digital infrastructure, public administration and more, with management bodies personally accountable for compliance.", "Being a directive, what binds you is the national transposition, not the text itself, so the detail varies by member state. ISO/IEC 27001 and IT-Grundschutz are the usual routes to demonstrating the required measures." ; dl:referenceLink "https://eur-lex.europa.eu/eli/dir/2022/2555/oj"^^xsd:anyURI, "https://digital-strategy.ec.europa.eu/en/policies/nis2-directive"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-dora a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "dora" ; skos:prefLabel "DORA"@en-GB ; dl:fullName "Digital Operational Resilience Act" ; dl:inRegulationCategory tax:regulation-category-eu-resilience-and-security-acts ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "European Union" ; dl:statusStatement "Regulation (EU) 2022/2554; applies since 17 January 2025" ; dl:description "ICT risk management, incident classification and reporting, resilience testing, and third-party risk oversight for financial entities, plus a supervisory regime for critical ICT providers serving them.", "The third-party chapter is what reaches data platforms: a register of information on every ICT contract, mandated contractual terms, exit strategies, and concentration risk analysis. Your data vendors become items in a supervisory filing." ; dl:referenceLink "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"^^xsd:anyURI, "https://www.esma.europa.eu/esmas-activities/digital-finance-and-innovation/digital-operational-resilience-act-dora"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-eu-cra a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "eu-cra" ; skos:prefLabel "CRA"@en-GB ; dl:fullName "Cyber Resilience Act" ; dl:inRegulationCategory tax:regulation-category-eu-resilience-and-security-acts ; dl:firstReleaseYear "2024"^^xsd:gYear ; dl:governanceStatement "European Union" ; dl:statusStatement "Regulation (EU) 2024/2847; reporting from September 2026, main obligations from December 2027" ; dl:description "Cybersecurity requirements for products with digital elements placed on the EU market: secure-by-design obligations, vulnerability handling for the support period, and reporting of actively exploited vulnerabilities.", "It puts an SBOM obligation into EU law for the first time, which is why SPDX and CycloneDX moved from good practice to procurement requirement." ; dl:referenceLink "https://eur-lex.europa.eu/eli/reg/2024/2847/oj"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-bcbs-239 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "bcbs-239" ; skos:prefLabel "BCBS 239"@en-GB ; dl:fullName "Principles for Effective Risk Data Aggregation and Risk Reporting" ; dl:inRegulationCategory tax:regulation-category-global-and-sector-regulation ; dl:firstReleaseYear "2013"^^xsd:gYear ; dl:governanceStatement "Basel Committee on Banking Supervision" ; dl:statusStatement "Published 2013; supervisory expectations ongoing" ; dl:description "Fourteen principles on governance, data architecture, accuracy, completeness, timeliness and adaptability of risk data, written for global systemically important banks after the financial crisis exposed how few could aggregate their own exposures quickly.", "It is the closest thing to a regulation about data architecture itself, and the reason lineage, ownership and data quality metrics are audited artefacts in banking. DCAM is the usual assessment vehicle." ; dl:referenceLink "https://www.bis.org/publ/bcbs239.htm"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-sox a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "sox" ; skos:prefLabel "SOX"@en-GB ; dl:fullName "Sarbanes-Oxley Act" ; dl:inRegulationCategory tax:regulation-category-global-and-sector-regulation ; dl:firstReleaseYear "2002"^^xsd:gYear ; dl:governanceStatement "US Congress / SEC / PCAOB" ; dl:statusStatement "Enacted 2002; Sections 302 and 404 drive the controls work" ; dl:description "Requires management and auditors to assess and attest to internal control over financial reporting, with personal certification by the CEO and CFO.", "Section 404 is why access controls, change management and audit trails on financial data pipelines are tested annually. Any data product feeding the numbers in a listed company's filings is in scope." ; dl:referenceLink "https://www.govinfo.gov/content/pkg/PLAW-107publ204/pdf/PLAW-107publ204.pdf"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US / Global" ; dl:appliesIn tax:jurisdiction-us, tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-hipaa a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "hipaa" ; skos:prefLabel "HIPAA"@en-GB ; dl:fullName "Health Insurance Portability and Accountability Act" ; dl:inRegulationCategory tax:regulation-category-global-and-sector-regulation ; dl:firstReleaseYear "1996"^^xsd:gYear ; dl:governanceStatement "US HHS / OCR" ; dl:statusStatement "Enacted 1996; Privacy, Security and Breach Notification Rules" ; dl:description "The US regime for protected health information: the Privacy Rule on permitted use and disclosure, the Security Rule on administrative, physical and technical safeguards, and mandatory breach notification.", "Its business associate agreements pull every downstream processor into scope, which is why de-identification and minimum-necessary access are design constraints on any health data platform touching the US." ; dl:referenceLink "https://www.hhs.gov/hipaa/index.html"^^xsd:anyURI, "https://www.ecfr.gov/current/title-45/subtitle-A/subchapter-C/part-164"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US" ; dl:appliesIn tax:jurisdiction-us ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-ccpa-cpra a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "ccpa-cpra" ; skos:prefLabel "CCPA / CPRA"@en-GB ; dl:fullName "California Consumer Privacy Act, as amended" ; dl:inRegulationCategory tax:regulation-category-global-and-sector-regulation ; dl:firstReleaseYear "2018"^^xsd:gYear ; dl:governanceStatement "California Privacy Protection Agency" ; dl:statusStatement "CCPA 2018, amended by CPRA; enforced by the CPPA" ; dl:description "California's consumer privacy regime: rights to know, delete, correct and opt out of the sale or sharing of personal information, plus limits on the use of sensitive personal information.", "It is the template most other US state privacy laws copied, so building for CCPA generally buys you the rest of the patchwork: an opt-out signal and a deletion path that actually reaches every downstream copy." ; dl:referenceLink "https://oag.ca.gov/privacy/ccpa"^^xsd:anyURI, "https://cppa.ca.gov/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US" ; dl:appliesIn tax:jurisdiction-us ; dl:hasGovernanceType tax:governance-law ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-dama-dmbok a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "dama-dmbok" ; skos:prefLabel "DAMA-DMBOK2"@en-GB ; dl:fullName "Data Management Body of Knowledge, 2nd Edition" ; dl:inRegulationCategory tax:regulation-category-data-management-frameworks ; dl:firstReleaseYear "2009"^^xsd:gYear ; dl:governanceStatement "DAMA International" ; dl:statusStatement "2nd edition (2017), revised 2024; a DMBOK 3.0 project started in 2025" ; dl:description "The reference body of knowledge for enterprise data management, organised around eleven knowledge areas: governance, architecture, modelling, storage, security, integration, reference and master data, warehousing, metadata, quality, and document management.", "It is not a certifiable standard and prescribes no controls. Its value under regulatory pressure is the shared vocabulary: when an auditor asks who owns a data set and how its quality is measured, DMBOK gives you the roles and processes to point at." ; dl:referenceLink "https://www.dama.org/cpages/body-of-knowledge"^^xsd:anyURI, "https://www.dama.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-dcam a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "dcam" ; skos:prefLabel "DCAM"@en-GB ; dl:fullName "Data Management Capability Assessment Model" ; dl:inRegulationCategory tax:regulation-category-data-management-frameworks ; dl:firstReleaseYear "2014"^^xsd:gYear ; dl:governanceStatement "EDM Council" ; dl:statusStatement "v3: eight components, 34 capabilities and 101 sub-capabilities" ; dl:description "A capability assessment model that scores an organisation's data management maturity across eight components, from data governance and architecture to data quality and technology architecture, broken down into 34 capabilities and 101 sub-capabilities.", "Widely used in banking and insurance as the structured evidence base behind BCBS 239 and comparable supervisory expectations. The assessment output is what turns \"we manage our data well\" into a defensible score with a remediation roadmap, run in-house or through an authorised partner." ; dl:referenceLink "https://edmcouncil.org/frameworks/dcam/"^^xsd:anyURI, "https://edmcouncil.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-cdmc a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "cdmc" ; skos:prefLabel "CDMC"@en-GB ; dl:fullName "Cloud Data Management Capabilities" ; dl:inRegulationCategory tax:regulation-category-data-management-frameworks ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "EDM Council" ; dl:statusStatement "v1.1 (2021); 14 key controls and automations" ; dl:description "A framework for managing and protecting sensitive data in cloud, multi-cloud and hybrid environments, built around fourteen key controls covering classification, ownership, cataloguing, entitlements, and data sovereignty.", "It is the cloud-native complement to DCAM rather than a replacement: the key controls are written to be automatable, which makes CDMC the more practical fit when your evidence has to come out of a lakehouse rather than a policy document." ; dl:referenceLink "https://edmcouncil.org/frameworks/cdmc/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-38505 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-38505" ; skos:prefLabel "ISO/IEC 38505"@en-GB ; dl:fullName "Governance of Data" ; dl:inRegulationCategory tax:regulation-category-data-management-frameworks ; dl:firstReleaseYear "2017"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 40" ; dl:statusStatement "Part 1 published 2017; Part 2 (data analytics) 2018" ; dl:description "Applies the ISO/IEC 38500 IT governance principles specifically to data, giving boards and executives a model for the accountability, strategy and conformance of data use.", "Deliberately high level: it tells a governing body what questions to ask, not how to implement controls. Pair it with a control framework if you need something auditable." ; dl:referenceLink "https://www.iso.org/standard/56639.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-8000 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-8000" ; skos:prefLabel "ISO 8000"@en-GB ; dl:fullName "Data Quality" ; dl:inRegulationCategory tax:regulation-category-metadata-and-quality ; dl:firstReleaseYear "2009"^^xsd:gYear ; dl:governanceStatement "ISO TC 184/SC 4" ; dl:statusStatement "Multi-part series; parts published from 2009 onwards" ; dl:description "A multi-part standard for data quality, best known for its master data parts: syntax, semantic encoding, provenance and the requirements a data set must meet to be exchanged between organisations without loss of meaning.", "It is the standard cited when quality has to be a contractual property of the data itself rather than a property of the pipeline that produced it, which is exactly the framing supply chain and product data regulation tends to use." ; dl:referenceLink "https://www.iso.org/standard/81745.html"^^xsd:anyURI, "https://www.iso.org/committee/54158.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-11179 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-11179" ; skos:prefLabel "ISO/IEC 11179"@en-GB ; dl:fullName "Metadata Registries" ; dl:inRegulationCategory tax:regulation-category-metadata-and-quality ; dl:firstReleaseYear "1999"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 32" ; dl:statusStatement "Multi-part series; Part 1 first published 1999" ; dl:description "Specifies how data elements are named, defined, classified and registered so that meaning survives movement between systems and organisations. It is the metadata registry model underneath national statistics offices, health data authorities and public sector registries.", "Heavyweight for a product team, but if you file data to a regulator that runs an 11179 registry, its concepts (data element concept, value domain, conceptual domain) are the shape your submissions have to take." ; dl:referenceLink "https://www.iso.org/standard/78914.html"^^xsd:anyURI, "https://www.iso.org/committee/45342.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-25012 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-25012" ; skos:prefLabel "ISO/IEC 25012"@en-GB ; dl:fullName "Data Quality Model" ; dl:inRegulationCategory tax:regulation-category-metadata-and-quality ; dl:firstReleaseYear "2008"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 7" ; dl:statusStatement "Published 2008; part of the SQuaRE series" ; dl:description "Defines a general data quality model with fifteen characteristics (accuracy, completeness, consistency, credibility, currentness, accessibility, compliance, confidentiality, and others), split into inherent and system-dependent views.", "Useful as the dictionary behind your data quality checks: when a contract or regulation says data must be \"accurate and complete\", 25012 is where those words have an agreed definition." ; dl:referenceLink "https://www.iso.org/standard/35736.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-odrl a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "odrl" ; skos:prefLabel "ODRL"@en-GB ; dl:fullName "Open Digital Rights Language" ; dl:inRegulationCategory tax:regulation-category-usage-policy-and-rights ; dl:firstReleaseYear "2018"^^xsd:gYear ; dl:governanceStatement "W3C" ; dl:statusStatement "ODRL 2.2 W3C Recommendation (2018)" ; dl:description "A policy expression language for permissions, prohibitions and obligations over any asset: who may use this data, for what purpose, under which constraint, and with what duty attached.", "It is the vocabulary European data space initiatives use to make terms of use machine-enforceable rather than PDF-shaped. If you need to carry a purpose limitation alongside the data itself, this is the standard to reach for." ; dl:referenceLink "https://www.w3.org/TR/odrl-model/"^^xsd:anyURI, "https://www.w3.org/TR/odrl-vocab/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-dpv a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "dpv" ; skos:prefLabel "DPV"@en-GB ; dl:fullName "Data Privacy Vocabulary" ; dl:inRegulationCategory tax:regulation-category-usage-policy-and-rights ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "W3C Data Privacy Vocabularies and Controls CG" ; dl:statusStatement "DPV 2.3 (2026); DPVCG report with GDPR, DGA, EHDS and AI Act extensions" ; dl:description "A vocabulary for expressing personal data handling in machine-readable form: personal data categories, purposes, legal bases, processing operations, recipients, and the technical and organisational measures applied.", "Ships with jurisdiction extensions (EU GDPR, EU AI Act, and others), which makes it the practical bridge between a records-of-processing obligation and metadata your catalogue can actually hold." ; dl:referenceLink "https://w3c-cg.github.io/dpv/"^^xsd:anyURI, "https://www.w3.org/community/dpvcg/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-opa a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "opa" ; skos:prefLabel "OPA"@en-GB ; dl:fullName "Open Policy Agent" ; dl:inRegulationCategory tax:regulation-category-usage-policy-and-rights ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "CNCF (graduated)" ; dl:statusStatement "CNCF graduated project since 2021; Rego policy language" ; dl:description "A general-purpose policy engine with its own declarative language, Rego. Policies are decoupled from the services that enforce them: the service asks OPA for a decision, OPA answers from policy and data.", "The compliance value is evidence. Policy is code, decisions are logged, and \"access was denied because of clause X\" becomes a query rather than an interview." ; dl:referenceLink "https://www.openpolicyagent.org/"^^xsd:anyURI, "https://github.com/open-policy-agent/opa"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-xacml a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "xacml" ; skos:prefLabel "XACML"@en-GB ; dl:fullName "eXtensible Access Control Markup Language" ; dl:inRegulationCategory tax:regulation-category-identity-and-access ; dl:firstReleaseYear "2003"^^xsd:gYear ; dl:governanceStatement "OASIS" ; dl:statusStatement "XACML 3.0 OASIS Standard (2013)" ; dl:description "The XML policy language and reference architecture that gave attribute-based access control its vocabulary: policy decision point, policy enforcement point, policy information point.", "The architecture outlived the syntax. New systems adopt the PDP/PEP split but express the policy in Rego or Cedar; you will still meet XACML in identity and healthcare platforms that standardised on it a decade ago." ; dl:referenceLink "https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html"^^xsd:anyURI, "https://www.oasis-open.org/committees/tc_home.php?wg_abbrev=xacml"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-27001 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-27001" ; skos:prefLabel "ISO/IEC 27001"@en-GB ; dl:fullName "Information Security Management Systems" ; dl:inRegulationCategory tax:regulation-category-management-systems ; dl:firstReleaseYear "2005"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 27" ; dl:statusStatement "ISO/IEC 27001:2022 current; certifiable" ; dl:description "The requirements standard for an information security management system: scope, risk assessment, risk treatment, the Annex A control set, and the management processes that keep it alive.", "It is the anchor certification of the compliance world. NIS2, DORA and sectoral supervisors do not mandate it by name, but an accredited 27001 certificate is the artefact most readily accepted as evidence that a management system exists." ; dl:referenceLink "https://www.iso.org/standard/27001"^^xsd:anyURI, "https://www.iso.org/committee/45306.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-nist-csf a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "nist-csf" ; skos:prefLabel "NIST CSF"@en-GB ; dl:fullName "Cybersecurity Framework 2.0" ; dl:inRegulationCategory tax:regulation-category-management-systems ; dl:firstReleaseYear "2014"^^xsd:gYear ; dl:governanceStatement "NIST" ; dl:statusStatement "CSF 2.0 (2024); six functions including Govern" ; dl:description "An outcome-based framework organised into six functions (Govern, Identify, Protect, Detect, Respond, Recover), each broken into categories and subcategories that describe what good looks like without prescribing how to get there.", "Version 2.0 added the Govern function and dropped the critical-infrastructure framing, which is what made it usable as a general risk-communication layer above whatever control catalogue you actually implement." ; dl:referenceLink "https://www.nist.gov/cyberframework"^^xsd:anyURI, "https://nvlpubs.nist.gov/nistpubs/CSWP/NIST.CSWP.29.pdf"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US / Global" ; dl:appliesIn tax:jurisdiction-us, tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-nist-rmf a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "nist-rmf" ; skos:prefLabel "NIST RMF"@en-GB ; dl:fullName "Risk Management Framework (SP 800-37)" ; dl:inRegulationCategory tax:regulation-category-management-systems ; dl:firstReleaseYear "2010"^^xsd:gYear ; dl:governanceStatement "NIST" ; dl:statusStatement "Revision 2 (2018)" ; dl:description "The seven-step process (prepare, categorise, select, implement, assess, authorise, monitor) that US federal systems follow to select and authorise security controls from SP 800-53.", "It is a process standard, not a control catalogue. Outside the US federal supply chain, the categorise-select-assess loop is worth borrowing even if the authorisation ceremony is not." ; dl:referenceLink "https://csrc.nist.gov/pubs/sp/800/37/r2/final"^^xsd:anyURI, "https://csrc.nist.gov/projects/risk-management"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US" ; dl:appliesIn tax:jurisdiction-us ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-bsi-grundschutz a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "bsi-grundschutz" ; skos:prefLabel "Grundschutz"@en-GB ; dl:fullName "BSI IT-Grundschutz" ; dl:inRegulationCategory tax:regulation-category-management-systems ; dl:firstReleaseYear "1994"^^xsd:gYear ; dl:governanceStatement "BSI (Germany)" ; dl:statusStatement "BSI Standards 200-1, 200-2 and 200-3, with 200-4 for business continuity; Kompendium revised regularly" ; dl:description "The German federal information security methodology: a modular catalogue of building blocks, each with concrete threats and required safeguards, plus the BSI Standards that describe the management system around them.", "Its distinguishing feature is prescriptiveness: where ISO/IEC 27001 says \"assess your risk\", IT-Grundschutz hands you a baseline of measures per component. Certification is available as ISO/IEC 27001 on the basis of IT-Grundschutz." ; dl:referenceLink "https://www.bsi.bund.de/EN/Themen/Unternehmen-und-Organisationen/Standards-und-Zertifizierung/IT-Grundschutz/it-grundschutz_node.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU / Germany" ; dl:appliesIn tax:jurisdiction-eu, tax:jurisdiction-germany ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-27002 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-27002" ; skos:prefLabel "ISO/IEC 27002"@en-GB ; dl:fullName "Information Security Controls" ; dl:inRegulationCategory tax:regulation-category-security-controls ; dl:firstReleaseYear "2005"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 27" ; dl:statusStatement "ISO/IEC 27002:2022; 93 controls in four themes" ; dl:description "The companion control catalogue to ISO/IEC 27001: for each control, what it is for, how to implement it, and what other guidance applies. The 2022 revision restructured 114 controls into 93 across organisational, people, physical and technological themes.", "It introduced attributes (control type, security property, operational capability) so controls can be mapped to other frameworks mechanically instead of by hand." ; dl:referenceLink "https://www.iso.org/standard/75652.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-nist-800-53 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "nist-800-53" ; skos:prefLabel "NIST SP 800-53"@en-GB ; dl:fullName "Security and Privacy Controls for Information Systems" ; dl:inRegulationCategory tax:regulation-category-security-controls ; dl:firstReleaseYear "2005"^^xsd:gYear ; dl:governanceStatement "NIST" ; dl:statusStatement "Revision 5 (2020); patch release 5.2.0 in 2025" ; dl:description "A catalogue of over a thousand security and privacy controls across twenty families, with baselines for low, moderate and high impact systems, published free of charge and machine-readable via OSCAL.", "Even outside US federal scope it is the reference people map to when two frameworks disagree: 800-53 usually has the finer-grained control that both can point at." ; dl:referenceLink "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"^^xsd:anyURI, "https://pages.nist.gov/OSCAL/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US / Global" ; dl:appliesIn tax:jurisdiction-us, tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-cis-controls a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "cis-controls" ; skos:prefLabel "CIS Controls"@en-GB ; dl:fullName "CIS Critical Security Controls" ; dl:inRegulationCategory tax:regulation-category-security-controls ; dl:firstReleaseYear "2008"^^xsd:gYear ; dl:governanceStatement "Center for Internet Security" ; dl:statusStatement "v8.1 (June 2024): 18 controls, 153 safeguards, three implementation groups" ; dl:description "Eighteen prioritised controls with 153 safeguards, split into three implementation groups so a small organisation can implement the first group and honestly claim a baseline.", "Paired with the CIS Benchmarks, the hardening configurations for operating systems, cloud services and databases that most CIS-aligned tooling actually checks against." ; dl:referenceLink "https://www.cisecurity.org/controls"^^xsd:anyURI, "https://www.cisecurity.org/cis-benchmarks"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-27701 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-27701" ; skos:prefLabel "ISO/IEC 27701"@en-GB ; dl:fullName "Privacy Information Management System" ; dl:inRegulationCategory tax:regulation-category-privacy ; dl:firstReleaseYear "2019"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 27" ; dl:statusStatement "27701:2019 as a 27001 extension; 2025 revision makes it standalone" ; dl:description "Extends an information security management system into a privacy information management system, with separate requirements for controllers and processors and a mapping annex to GDPR articles.", "The GDPR mapping is the reason it matters: it turns \"we comply with GDPR\" into a set of auditable management-system requirements a certification body can actually test." ; dl:referenceLink "https://www.iso.org/standard/85819.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-27018 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-27018" ; skos:prefLabel "ISO/IEC 27018"@en-GB ; dl:fullName "Protection of PII in Public Clouds" ; dl:inRegulationCategory tax:regulation-category-privacy ; dl:firstReleaseYear "2014"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 27" ; dl:statusStatement "ISO/IEC 27018:2019" ; dl:description "A code of practice for public cloud providers acting as processors of personally identifiable information: consent and choice, purpose limitation, disclosure to third parties, return and deletion, and transparency about sub-processors.", "Every major cloud provider certifies against it, so it is more often something you inherit from a vendor than something you implement, but it is the right question to ask of any processor in the chain." ; dl:referenceLink "https://www.iso.org/standard/76559.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-nist-privacy a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "nist-privacy" ; skos:prefLabel "NIST Privacy Framework"@en-GB ; dl:fullName "NIST Privacy Framework" ; dl:inRegulationCategory tax:regulation-category-privacy ; dl:firstReleaseYear "2020"^^xsd:gYear ; dl:governanceStatement "NIST" ; dl:statusStatement "Version 1.0 (2020); 1.1 in development alongside CSF 2.0" ; dl:description "A voluntary framework structured like the Cybersecurity Framework (Identify, Govern, Control, Communicate, Protect) for managing privacy risk arising from data processing, not only from breaches.", "Its useful contribution is separating privacy risk from security risk: problematic data actions can be entirely secure and still harm people. That distinction is what data minimisation and purpose limitation arguments hang on." ; dl:referenceLink "https://www.nist.gov/privacy-framework"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US / Global" ; dl:appliesIn tax:jurisdiction-us, tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-29100 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-29100" ; skos:prefLabel "ISO/IEC 29100"@en-GB ; dl:fullName "Privacy Framework" ; dl:inRegulationCategory tax:regulation-category-privacy ; dl:firstReleaseYear "2011"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 27" ; dl:statusStatement "Published 2011, amended 2018" ; dl:description "The privacy terminology and principles standard: PII, PII principal, PII controller, PII processor, and eleven privacy principles that later ISO privacy standards build on.", "Still the normative source of those definitions, but as an implementation target it has been overtaken by ISO/IEC 27701 and the 27018/27550 family." ; dl:referenceLink "https://www.iso.org/standard/45123.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-mitre-attack a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "mitre-attack" ; skos:prefLabel "MITRE ATT&CK"@en-GB ; dl:fullName "Adversarial Tactics, Techniques and Common Knowledge" ; dl:inRegulationCategory tax:regulation-category-threat-intelligence ; dl:firstReleaseYear "2013"^^xsd:gYear ; dl:governanceStatement "MITRE" ; dl:statusStatement "Enterprise, Mobile and ICS matrices; annual releases (v19, April 2026)" ; dl:description "A curated knowledge base of adversary tactics and techniques observed in the wild, organised as matrices and identified by stable technique IDs.", "Those IDs are the point. Detections, threat reports, purple-team exercises and supervisory incident reports can all reference the same technique, which is how you answer \"are we covered?\" with a map rather than an opinion." ; dl:referenceLink "https://attack.mitre.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-mitre-d3fend a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "mitre-d3fend" ; skos:prefLabel "MITRE D3FEND"@en-GB ; dl:fullName "Defensive Countermeasures Knowledge Graph" ; dl:inRegulationCategory tax:regulation-category-threat-intelligence ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "MITRE" ; dl:statusStatement "1.0 released January 2025; matrix at version 1.4" ; dl:description "A knowledge graph of defensive techniques across seven tactics (model, harden, detect, isolate, deceive, evict, restore) with explicit digital artefact relationships linking each countermeasure to the offensive techniques it addresses.", "Where ATT&CK tells you what attackers do, D3FEND gives you a vocabulary for what your controls actually do about it. Adoption in commercial tooling is growing but not yet the default." ; dl:referenceLink "https://d3fend.mitre.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-cwe a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "cwe" ; skos:prefLabel "CWE"@en-GB ; dl:fullName "Common Weakness Enumeration" ; dl:inRegulationCategory tax:regulation-category-threat-intelligence ; dl:firstReleaseYear "2006"^^xsd:gYear ; dl:governanceStatement "MITRE / CISA" ; dl:statusStatement "Actively maintained; CWE Top 25 published annually" ; dl:description "A hierarchical catalogue of software and hardware weakness types: the class of flaw (CWE) as distinct from the individual vulnerability instance (CVE).", "Static analysis findings, penetration test reports and secure development requirements all reference CWE IDs, which makes it the join key between your scanner output and the control you claim satisfies it." ; dl:referenceLink "https://cwe.mitre.org/"^^xsd:anyURI, "https://cwe.mitre.org/top25/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-capec a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "capec" ; skos:prefLabel "CAPEC"@en-GB ; dl:fullName "Common Attack Pattern Enumeration and Classification" ; dl:inRegulationCategory tax:regulation-category-threat-intelligence ; dl:firstReleaseYear "2007"^^xsd:gYear ; dl:governanceStatement "MITRE" ; dl:statusStatement "Actively maintained; cross-referenced with CWE and ATT&CK" ; dl:description "A catalogue of attack patterns, the method by which a weakness is exploited, cross-referenced to the CWE weaknesses they target and the ATT&CK techniques they realise.", "It sits between the two: use it when a threat model needs to explain how a specific weakness becomes a specific technique." ; dl:referenceLink "https://capec.mitre.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-stix a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "stix" ; skos:prefLabel "STIX"@en-GB ; dl:fullName "Structured Threat Information Expression" ; dl:inRegulationCategory tax:regulation-category-threat-intelligence ; dl:firstReleaseYear "2012"^^xsd:gYear ; dl:governanceStatement "OASIS Cyber Threat Intelligence TC" ; dl:statusStatement "STIX 2.1 OASIS Standard (2021), with errata published in 2025" ; dl:description "A JSON data model for cyber threat intelligence: indicators, observed data, threat actors, campaigns, malware, courses of action, and the relationships between them.", "Relevant to regulated entities mainly through mandated reporting and sector information-sharing schemes, where the ISAC or supervisor expects machine-readable submissions rather than email." ; dl:referenceLink "https://docs.oasis-open.org/cti/stix/v2.1/stix-v2.1.html"^^xsd:anyURI, "https://www.oasis-open.org/committees/tc_home.php?wg_abbrev=cti"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-taxii a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "taxii" ; skos:prefLabel "TAXII"@en-GB ; dl:fullName "Trusted Automated Exchange of Intelligence Information" ; dl:inRegulationCategory tax:regulation-category-threat-intelligence ; dl:firstReleaseYear "2012"^^xsd:gYear ; dl:governanceStatement "OASIS Cyber Threat Intelligence TC" ; dl:statusStatement "TAXII 2.1 OASIS Standard (2021)" ; dl:description "The HTTPS application protocol for exchanging STIX content: collections to pull from, channels to subscribe to, and the API endpoints a sharing community agrees on.", "Deploy it when you join a sharing community that runs one; there is no reason to adopt it in isolation." ; dl:referenceLink "https://docs.oasis-open.org/cti/taxii/v2.1/taxii-v2.1.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-42001 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-42001" ; skos:prefLabel "ISO/IEC 42001"@en-GB ; dl:fullName "Artificial Intelligence Management System" ; dl:inRegulationCategory tax:regulation-category-ai-governance ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 42" ; dl:statusStatement "Published December 2023; certifiable" ; dl:description "A management system standard for artificial intelligence, built on the same Annex SL structure as ISO/IEC 27001: context, leadership, planning, support, operation, evaluation, improvement, with AI-specific controls covering impact assessment, data for AI systems, and lifecycle documentation.", "It does not make you AI Act compliant on its own; the Act's harmonised standards are being written by CEN-CENELEC. But it is the management system regulators, customers and insurers can already audit against, and its documentation obligations line up closely with the Act's technical documentation requirements." ; dl:referenceLink "https://www.iso.org/standard/42001"^^xsd:anyURI, "https://www.iso.org/committee/6794475.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-23894 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-23894" ; skos:prefLabel "ISO/IEC 23894"@en-GB ; dl:fullName "AI Risk Management Guidance" ; dl:inRegulationCategory tax:regulation-category-ai-governance ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 42" ; dl:statusStatement "Published 2023" ; dl:description "Guidance on managing risk specific to AI systems, applying the ISO 31000 risk management process to AI-specific sources of risk: data quality, model behaviour, autonomy, transparency, and human oversight.", "Non-certifiable and deliberately procedural. Read it as the implementation companion when 42001 asks for an AI risk assessment and you need to decide what that actually contains." ; dl:referenceLink "https://www.iso.org/standard/77304.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-nist-ai-rmf a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "nist-ai-rmf" ; skos:prefLabel "NIST AI RMF"@en-GB ; dl:fullName "AI Risk Management Framework" ; dl:inRegulationCategory tax:regulation-category-ai-governance ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "NIST" ; dl:statusStatement "AI RMF 1.0 (2023) plus the Generative AI Profile (2024)" ; dl:description "A voluntary framework organised into four functions (Govern, Map, Measure, Manage) for identifying and managing risks across the AI lifecycle, with a companion playbook of concrete actions.", "The Generative AI Profile extends it to foundation-model risks: confabulation, data leakage, provenance, and the supply chain of models you did not train yourself." ; dl:referenceLink "https://www.nist.gov/itl/ai-risk-management-framework"^^xsd:anyURI, "https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.100-1.pdf"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US / Global" ; dl:appliesIn tax:jurisdiction-us, tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-cen-clc-jtc21 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "cen-clc-jtc21" ; skos:prefLabel "JTC 21"@en-GB ; dl:fullName "CEN-CENELEC JTC 21: Harmonised European Standards for AI" ; dl:inRegulationCategory tax:regulation-category-ai-governance ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "CEN-CENELEC JTC 21" ; dl:statusStatement "Standardisation request under the AI Act; deliverables in progress, none yet cited in the Official Journal" ; dl:description "The joint technical committee drafting the harmonised European standards for the EU AI Act, covering risk management, data governance and data quality, transparency, human oversight, accuracy and robustness, and conformity assessment for high-risk AI systems.", "Once cited in the Official Journal, conformity with these standards gives a presumption of conformity with the corresponding AI Act requirements, which is why anyone building high-risk AI in Europe should be tracking the drafts rather than waiting." ; dl:referenceLink "https://www.cencenelec.eu/areas-of-work/cen-cenelec-topics/artificial-intelligence/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-5259 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-5259" ; skos:prefLabel "ISO/IEC 5259"@en-GB ; dl:fullName "Data Quality for Analytics and Machine Learning" ; dl:inRegulationCategory tax:regulation-category-ai-governance ; dl:firstReleaseYear "2024"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 42" ; dl:statusStatement "Multi-part series; core parts published from 2024" ; dl:description "A series covering data quality for analytics and machine learning: vocabulary, quality measures, management requirements, a process framework, and governance of the data used to train and evaluate models.", "It is the standards work that most directly addresses what \"relevant, representative, free of errors and complete\" is supposed to mean when a regulator says it about training data." ; dl:referenceLink "https://www.iso.org/standard/81088.html"^^xsd:anyURI, "https://www.iso.org/committee/6794475.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-owasp-llm-top10 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "owasp-llm-top10" ; skos:prefLabel "OWASP LLM Top 10"@en-GB ; dl:fullName "OWASP Top 10 for LLM Applications" ; dl:inRegulationCategory tax:regulation-category-application-and-api-security ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "OWASP" ; dl:statusStatement "2025 edition (March 2025); part of the OWASP GenAI Security Project" ; dl:description "The consensus risk list for applications built on large language models: prompt injection, sensitive information disclosure, supply chain, data and model poisoning, improper output handling, excessive agency, and more.", "Directly relevant wherever an LLM touches governed data: a retrieval pipeline over regulated data inherits every one of these risks, and this is the list auditors have started asking about by name." ; dl:referenceLink "https://genai.owasp.org/llm-top-10/"^^xsd:anyURI, "https://genai.owasp.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-owasp-api-top10 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "owasp-api-top10" ; skos:prefLabel "OWASP API Top 10"@en-GB ; dl:fullName "OWASP API Security Top 10" ; dl:inRegulationCategory tax:regulation-category-application-and-api-security ; dl:firstReleaseYear "2019"^^xsd:gYear ; dl:governanceStatement "OWASP" ; dl:statusStatement "2023 edition" ; dl:description "The API-specific risk list: broken object level authorisation, broken authentication, broken object property level authorisation, unrestricted resource consumption, and the rest of the failures that dominate real API breaches.", "Authorisation failures top the list because APIs expose object identifiers directly, the same shape of mistake that turns a data product output port into an unintended bulk export." ; dl:referenceLink "https://owasp.org/API-Security/editions/2023/en/0x11-t10/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-owasp-asvs a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "owasp-asvs" ; skos:prefLabel "OWASP ASVS"@en-GB ; dl:fullName "Application Security Verification Standard" ; dl:inRegulationCategory tax:regulation-category-application-and-api-security ; dl:firstReleaseYear "2009"^^xsd:gYear ; dl:governanceStatement "OWASP" ; dl:statusStatement "Version 5.0 (2025)" ; dl:description "A catalogue of application security requirements organised into verification levels, written so each requirement can be tested rather than asserted.", "Unlike the Top 10 lists, ASVS is a requirements standard: it is what you put in a supplier contract or a definition of done when \"secure\" has to survive contact with an auditor." ; dl:referenceLink "https://owasp.org/www-project-application-security-verification-standard/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-owasp-samm a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "owasp-samm" ; skos:prefLabel "OWASP SAMM"@en-GB ; dl:fullName "Software Assurance Maturity Model" ; dl:inRegulationCategory tax:regulation-category-application-and-api-security ; dl:firstReleaseYear "2009"^^xsd:gYear ; dl:governanceStatement "OWASP" ; dl:statusStatement "Version 2 (2020)" ; dl:description "A maturity model for secure software delivery across five business functions (governance, design, implementation, verification, operations), each with streams scored at three maturity levels.", "Its purpose is direction rather than certification: measure where you are, choose the next increment, re-measure. The output is a roadmap, which is what most secure-development clauses in regulation actually expect you to have." ; dl:referenceLink "https://owaspsamm.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-owasp-ml-top10 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "owasp-ml-top10" ; skos:prefLabel "OWASP ML Top 10"@en-GB ; dl:fullName "OWASP Machine Learning Security Top 10" ; dl:inRegulationCategory tax:regulation-category-application-and-api-security ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "OWASP" ; dl:statusStatement "Draft; superseded in practice by the GenAI project for LLM work" ; dl:description "A risk list for classical machine learning systems: input manipulation, data poisoning, model inversion, membership inference, model theft, and transfer learning attacks.", "Still the better reference for a trained-in-house model that is not a language model. Treat it as a checklist rather than a standard: the document has been in draft for years." ; dl:referenceLink "https://owasp.org/www-project-machine-learning-security-top-10/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-csa-ccm a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "csa-ccm" ; skos:prefLabel "CSA CCM"@en-GB ; dl:fullName "Cloud Controls Matrix" ; dl:inRegulationCategory tax:regulation-category-cloud-and-certification ; dl:firstReleaseYear "2010"^^xsd:gYear ; dl:governanceStatement "Cloud Security Alliance" ; dl:statusStatement "CCM v4.1: 197 control objectives in 17 domains; CAIQ and the STAR registry" ; dl:description "A cloud-specific control framework of nearly two hundred control objectives across seventeen domains, with a shared responsibility model that says which controls belong to the provider and which to the customer.", "The companion CAIQ questionnaire and the public STAR registry are what make it operationally useful: for most major cloud services, the answers already exist and can be diffed rather than requested." ; dl:referenceLink "https://cloudsecurityalliance.org/research/cloud-controls-matrix"^^xsd:anyURI, "https://cloudsecurityalliance.org/star/registry"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-iso-27017 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "iso-27017" ; skos:prefLabel "ISO/IEC 27017"@en-GB ; dl:fullName "Cloud Security Controls" ; dl:inRegulationCategory tax:regulation-category-cloud-and-certification ; dl:firstReleaseYear "2015"^^xsd:gYear ; dl:governanceStatement "ISO/IEC JTC 1/SC 27" ; dl:statusStatement "ISO/IEC 27017:2015" ; dl:description "A code of practice adding cloud-specific implementation guidance to the ISO/IEC 27002 controls, plus seven controls that exist only in a cloud context: shared roles, virtual machine hardening, administrator operations, monitoring, and segregation in virtual environments.", "Certification is normally an extension of a 27001 audit rather than a standalone exercise." ; dl:referenceLink "https://www.iso.org/standard/43757.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-bsi-c5 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "bsi-c5" ; skos:prefLabel "BSI C5"@en-GB ; dl:fullName "Cloud Computing Compliance Criteria Catalogue" ; dl:inRegulationCategory tax:regulation-category-cloud-and-certification ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "BSI (Germany)" ; dl:statusStatement "C5:2020: 121 criteria in 17 areas; attested under ISAE 3000" ; dl:description "A criteria catalogue for cloud service security, assessed by an auditor and reported as an attestation rather than a certificate, so the customer receives a full report, including the auditor's findings, not just a pass mark.", "The transparency criteria are the distinctive part: providers must disclose jurisdiction, data location, and the legal environment they operate under, which is exactly what a European data sovereignty review needs to see." ; dl:referenceLink "https://www.bsi.bund.de/EN/Themen/Unternehmen-und-Organisationen/Informationen-und-Empfehlungen/Empfehlungen-nach-Angriffszielen/Cloud-Computing/Kriterienkatalog-C5/kriterienkatalog-c5_node.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU / Germany" ; dl:appliesIn tax:jurisdiction-eu, tax:jurisdiction-germany ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-eu-cloud-coc a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "eu-cloud-coc" ; skos:prefLabel "EU Cloud CoC"@en-GB ; dl:fullName "EU Cloud Code of Conduct" ; dl:inRegulationCategory tax:regulation-category-cloud-and-certification ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "SCOPE Europe" ; dl:statusStatement "Approved under GDPR Article 40 (2021); monitored by SCOPE Europe" ; dl:description "A code of conduct for cloud providers acting as processors, formally approved by the Belgian data protection authority under GDPR Article 40 with an accredited monitoring body.", "Adherence is one of the mechanisms GDPR explicitly recognises for demonstrating sufficient guarantees from a processor, which makes it a lighter alternative to bespoke due diligence when it is available." ; dl:referenceLink "https://eucoc.cloud/en/home"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-soc2 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "soc2" ; skos:prefLabel "SOC 2"@en-GB ; dl:fullName "Trust Services Criteria (SOC 2)" ; dl:inRegulationCategory tax:regulation-category-audit-and-attestation ; dl:firstReleaseYear "2011"^^xsd:gYear ; dl:governanceStatement "AICPA" ; dl:statusStatement "Trust Services Criteria (2017, revised points of focus 2022)" ; dl:description "An attestation report by an independent auditor against five trust services criteria: security, availability, processing integrity, confidentiality and privacy. A Type I report covers design at a point in time; Type II covers operating effectiveness over a period.", "Not a certification and not a European instrument, but for SaaS vendors it is the de-facto entry ticket, and the Type II report is the evidence pack most third-party risk teams open first." ; dl:referenceLink "https://www.aicpa-cima.com/topic/audit-assurance/audit-and-assurance-greater-than-soc-2"^^xsd:anyURI ; dl:sourceJurisdictionLabel "US / Global" ; dl:appliesIn tax:jurisdiction-us, tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-isae-3402 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "isae-3402" ; skos:prefLabel "ISAE 3402"@en-GB ; dl:fullName "Assurance Reports on Controls at a Service Organization" ; dl:inRegulationCategory tax:regulation-category-audit-and-attestation ; dl:firstReleaseYear "2009"^^xsd:gYear ; dl:governanceStatement "IAASB" ; dl:statusStatement "Effective since 2011; the international counterpart to SSAE 18" ; dl:description "The international assurance standard for reporting on controls at a service organisation that are relevant to its customers' financial reporting: the report an outsourced provider gives its clients' auditors.", "Where SOC 2 answers security questions, ISAE 3402 answers the auditor's question about whether your controls can be relied on in someone else's financial statements. ISAE 3000 covers the same mechanics for non-financial subject matter, including BSI C5." ; dl:referenceLink "https://www.iaasb.org/standards-pronouncements"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-spdx a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "spdx" ; skos:prefLabel "SPDX"@en-GB ; dl:fullName "System Package Data Exchange" ; dl:inRegulationCategory tax:regulation-category-software-supply-chain ; dl:firstReleaseYear "2011"^^xsd:gYear ; dl:governanceStatement "Linux Foundation" ; dl:statusStatement "SPDX 3.0 (2024), 3.1 in review; version 2.2.1 published as ISO/IEC 5962:2021" ; dl:description "A bill-of-materials standard for describing software components, licences, copyrights and security references. SPDX 3.0 generalised the model to cover builds, AI models, datasets and services alongside packages.", "The dataset and AI profiles matter here: they are the closest thing to a standard way of shipping a machine-readable declaration of what data a model was trained on." ; dl:referenceLink "https://spdx.dev/"^^xsd:anyURI, "https://www.iso.org/standard/81870.html"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-cyclonedx a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "cyclonedx" ; skos:prefLabel "CycloneDX"@en-GB ; dl:fullName "CycloneDX Bill of Materials" ; dl:inRegulationCategory tax:regulation-category-software-supply-chain ; dl:firstReleaseYear "2017"^^xsd:gYear ; dl:governanceStatement "OWASP" ; dl:statusStatement "CycloneDX v1.7, published as ECMA-424 (2nd edition, 2025); SBOM, SaaSBOM, ML-BOM, CBOM and VEX" ; dl:description "A bill-of-materials standard designed for security use cases, covering software, services, hardware, machine learning models and cryptographic assets, with VEX support for stating whether a vulnerability actually affects you.", "The ML-BOM and CBOM profiles are directly regulatory: one documents model and dataset provenance, the other inventories cryptography ahead of post-quantum migration mandates." ; dl:referenceLink "https://cyclonedx.org/"^^xsd:anyURI, "https://ecma-international.org/publications-and-standards/standards/ecma-424/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-slsa a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "slsa" ; skos:prefLabel "SLSA"@en-GB ; dl:fullName "Supply-chain Levels for Software Artifacts" ; dl:inRegulationCategory tax:regulation-category-software-supply-chain ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "OpenSSF" ; dl:statusStatement "v1.2 current, adding a source track; v1.0 released 2023" ; dl:description "A framework of graduated levels for build integrity and provenance: what a build platform must guarantee at each of build levels L0 to L3, and what the resulting provenance attestation must say about how an artefact was produced. Version 1.2 adds a source track alongside it.", "It is the concrete answer to \"prove this binary came from that source\", the requirement underneath most modern software supply chain expectations." ; dl:referenceLink "https://slsa.dev/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-sigstore a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "sigstore" ; skos:prefLabel "Sigstore"@en-GB ; dl:fullName "Sigstore" ; dl:inRegulationCategory tax:regulation-category-software-supply-chain ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "OpenSSF" ; dl:statusStatement "Production; Fulcio, Rekor and Cosign" ; dl:description "Signing infrastructure for software artefacts using short-lived certificates tied to an OIDC identity, with signatures recorded in a public transparency log.", "The keyless model is why it gets adopted: no long-lived signing key to protect, and the transparency log gives an auditor something to check independently." ; dl:referenceLink "https://www.sigstore.dev/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-in-toto a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "in-toto" ; skos:prefLabel "in-toto"@en-GB ; dl:fullName "in-toto Attestation Framework" ; dl:inRegulationCategory tax:regulation-category-software-supply-chain ; dl:firstReleaseYear "2016"^^xsd:gYear ; dl:governanceStatement "CNCF" ; dl:statusStatement "CNCF graduated project (2025); in-toto Attestation Framework v1.0" ; dl:description "A framework for cryptographically verifying that every step of a software supply chain was carried out by the intended party, in the intended order, on the intended materials.", "Its attestation format is the substrate SLSA provenance is carried in, so adopt it as plumbing rather than as a programme of its own." ; dl:referenceLink "https://in-toto.io/"^^xsd:anyURI, "https://github.com/in-toto/attestation"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-gaia-x a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "gaia-x" ; skos:prefLabel "Gaia-X"@en-GB ; dl:fullName "Gaia-X Trust Framework" ; dl:inRegulationCategory tax:regulation-category-data-spaces-and-sovereignty ; dl:firstReleaseYear "2021"^^xsd:gYear ; dl:governanceStatement "Gaia-X AISBL" ; dl:statusStatement "Trust Framework with compliance and clearing house services" ; dl:description "A trust framework for European data infrastructure: self-descriptions of participants, services and resources as verifiable credentials, validated against machine-readable compliance rules by clearing houses.", "The idea worth borrowing regardless of your view on the initiative is that jurisdiction, data location and applicable law become attributes of a service that a machine can check, not claims in a sales deck." ; dl:referenceLink "https://gaia-x.eu/"^^xsd:anyURI, "https://docs.gaia-x.eu/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-dataspace-protocol a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "dataspace-protocol" ; skos:prefLabel "Dataspace Protocol"@en-GB ; dl:fullName "Dataspace Protocol" ; dl:inRegulationCategory tax:regulation-category-data-spaces-and-sovereignty ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "IDSA / Eclipse Dataspace Working Group" ; dl:statusStatement "Release 2025-1; maintained by the Eclipse Dataspace Working Group" ; dl:description "A protocol for sovereign data exchange: catalogue discovery, contract negotiation over ODRL usage policies, and a transfer process that hands off to whatever data plane the parties agree on.", "It is the machinery that makes \"data stays under the provider's terms\" enforceable across organisational boundaries, and the reference protocol for EU data space implementations such as the Eclipse Dataspace Components." ; dl:referenceLink "https://eclipse-dataspace-protocol-base.github.io/DataspaceProtocol/"^^xsd:anyURI, "https://dataspace.eclipse.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-dssc-blueprint a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "dssc-blueprint" ; skos:prefLabel "DSSC Blueprint"@en-GB ; dl:fullName "Data Spaces Blueprint" ; dl:inRegulationCategory tax:regulation-category-data-spaces-and-sovereignty ; dl:firstReleaseYear "2023"^^xsd:gYear ; dl:governanceStatement "Data Spaces Support Centre" ; dl:statusStatement "Blueprint 3.0, the concluding version of the DSSC project" ; dl:description "The European Commission-funded reference blueprint for data spaces: the building blocks a data space needs for identity, trust, contracts, vocabularies, and data exchange, with the standards that fill each slot.", "Read it as the index to the sector data spaces being built under the Data Governance Act and the Data Act: it tells you which specification each participating initiative expects you to implement." ; dl:referenceLink "https://blueprint.dssc.eu/"^^xsd:anyURI, "https://dssc.eu/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-ids-ram a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "ids-ram" ; skos:prefLabel "IDS-RAM"@en-GB ; dl:fullName "International Data Spaces Reference Architecture Model" ; dl:inRegulationCategory tax:regulation-category-data-spaces-and-sovereignty ; dl:firstReleaseYear "2019"^^xsd:gYear ; dl:governanceStatement "International Data Spaces Association" ; dl:statusStatement "RAM 4 is the stable edition, with 2026-1 in draft; the connector concept lives on in the Dataspace Protocol" ; dl:description "The architecture model that introduced the data space vocabulary in Europe: connectors, identity providers, clearing houses, vocabulary hubs, and the sovereign exchange of data between them.", "Its concepts survive; its own protocol layer has effectively been superseded by the Dataspace Protocol, which is where the interoperability work has moved." ; dl:referenceLink "https://kb.internationaldataspaces.org/external/ram/"^^xsd:anyURI, "https://internationaldataspaces.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "EU" ; dl:appliesIn tax:jurisdiction-eu ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-saml a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "saml" ; skos:prefLabel "SAML"@en-GB ; dl:fullName "Security Assertion Markup Language" ; dl:inRegulationCategory tax:regulation-category-identity-and-access ; dl:firstReleaseYear "2002"^^xsd:gYear ; dl:governanceStatement "OASIS" ; dl:statusStatement "SAML 2.0 OASIS Standard (2005)" ; dl:description "The XML standard for exchanging authentication and authorisation assertions between an identity provider and a service provider. It is what most enterprise single sign-on still runs on.", "It matters here because access control evidence starts with authentication: an auditor asking who could reach a data set is really asking which identity provider vouched for them, and what the assertion claimed." ; dl:referenceLink "https://docs.oasis-open.org/security/saml/v2.0/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-oauth2 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "oauth2" ; skos:prefLabel "OAuth 2.0"@en-GB ; dl:fullName "OAuth 2.0 Authorization Framework" ; dl:inRegulationCategory tax:regulation-category-identity-and-access ; dl:firstReleaseYear "2012"^^xsd:gYear ; dl:governanceStatement "IETF" ; dl:statusStatement "RFC 6749 with a large family of extensions" ; dl:description "The delegated authorisation framework behind almost every modern API: a client obtains a scoped, time limited token instead of the user's credentials.", "Scopes and token lifetimes are the enforcement points a control framework leans on, and token issuance logs are the evidence that least privilege was more than an intention." ; dl:referenceLink "https://www.rfc-editor.org/rfc/rfc6749"^^xsd:anyURI, "https://www.rfc-editor.org/rfc/rfc9700"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-oidc a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "oidc" ; skos:prefLabel "OpenID Connect"@en-GB ; dl:fullName "OpenID Connect Core" ; dl:inRegulationCategory tax:regulation-category-identity-and-access ; dl:firstReleaseYear "2014"^^xsd:gYear ; dl:governanceStatement "OpenID Foundation" ; dl:statusStatement "OpenID Connect Core 1.0; widely certified" ; dl:description "An identity layer on top of OAuth 2.0: the ID token carries verified claims about who the user is, alongside the access token that says what they may do.", "Its certification programme is the practical part. Where a control requires federated identity, pointing at a certified implementation is a shorter conversation than describing your own." ; dl:referenceLink "https://openid.net/specs/openid-connect-core-1_0.html"^^xsd:anyURI, "https://openid.net/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-scim a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "scim" ; skos:prefLabel "SCIM"@en-GB ; dl:fullName "System for Cross-domain Identity Management" ; dl:inRegulationCategory tax:regulation-category-identity-and-access ; dl:firstReleaseYear "2015"^^xsd:gYear ; dl:governanceStatement "IETF" ; dl:statusStatement "SCIM 2.0 (RFC 7642, 7643, 7644)" ; dl:description "A schema and REST protocol for provisioning and deprovisioning user accounts and groups between systems.", "Deprovisioning is the audit finding it prevents. Joiner, mover and leaver controls only hold if account removal propagates automatically to every tool holding data, which is precisely what SCIM automates." ; dl:referenceLink "https://www.rfc-editor.org/rfc/rfc7644"^^xsd:anyURI, "https://scim.cloud/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-did a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "did" ; skos:prefLabel "DID"@en-GB ; dl:fullName "Decentralized Identifiers" ; dl:inRegulationCategory tax:regulation-category-agent-identity-and-trust ; dl:firstReleaseYear "2022"^^xsd:gYear ; dl:governanceStatement "W3C" ; dl:statusStatement "DID Core 1.0 W3C Recommendation (2022)" ; dl:description "Globally unique identifiers that resolve to a document describing how to authenticate the subject, without depending on a central registry.", "The reason it appears on a compliance map: European data spaces and agent ecosystems both need a party to prove who it is across organisational boundaries, and a DID is the identifier those trust frameworks are built on." ; dl:referenceLink "https://www.w3.org/TR/did-core/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-verifiable-credentials a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "verifiable-credentials" ; skos:prefLabel "Verifiable Credentials"@en-GB ; dl:fullName "Verifiable Credentials Data Model" ; dl:inRegulationCategory tax:regulation-category-agent-identity-and-trust ; dl:firstReleaseYear "2019"^^xsd:gYear ; dl:governanceStatement "W3C" ; dl:statusStatement "VC Data Model 2.0 W3C Recommendation" ; dl:description "A data model for tamper evident claims that a holder can present and a verifier can check cryptographically, without contacting the issuer.", "Gaia-X self descriptions and the EU digital identity wallet both rest on it. It is how an assertion such as \"this service is certified and hosted in the EU\" becomes machine checkable rather than a claim in a brochure." ; dl:referenceLink "https://www.w3.org/TR/vc-data-model-2.0/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-formal-standard ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-acp a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "acp" ; skos:prefLabel "ACP"@en-GB ; dl:fullName "Agent Communication Protocol" ; dl:inRegulationCategory tax:regulation-category-agent-interaction ; dl:firstReleaseYear "2025"^^xsd:gYear ; dl:governanceStatement "Linux Foundation" ; dl:statusStatement "Merged into A2A under the Linux Foundation (2025)" ; dl:description "An open protocol for agents to discover each other and exchange tasks, launched by IBM Research in 2025 for the BeeAI platform and donated to the Linux Foundation with it.", "Listed for completeness rather than as a target: the effort has been folding into A2A, so new work should look there first." ; dl:referenceLink "https://agentcommunicationprotocol.dev/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-foundation ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-ag-ui a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "ag-ui" ; skos:prefLabel "AG-UI"@en-GB ; dl:fullName "Agent User Interaction Protocol" ; dl:inRegulationCategory tax:regulation-category-agent-interaction ; dl:firstReleaseYear "2025"^^xsd:gYear ; dl:governanceStatement "CopilotKit and the AG-UI community" ; dl:statusStatement "Open specification with reference implementations" ; dl:description "An event based protocol between agent backends and user facing applications, covering streaming output, tool calls, state updates and human approval steps.", "Its compliance relevance is human oversight. Where the AI Act expects a person to be able to intervene, the interaction protocol is where that intervention is actually implemented and logged." ; dl:referenceLink "https://docs.ag-ui.com/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:regulation-ap2 a dl:LandscapeEntry, dl:DataRegulationLandscapeEntry ; dl:identifier "ap2" ; skos:prefLabel "AP2"@en-GB ; dl:fullName "Agent Payments Protocol" ; dl:inRegulationCategory tax:regulation-category-agent-interaction ; dl:firstReleaseYear "2025"^^xsd:gYear ; dl:governanceStatement "Google; standardisation moving to the FIDO Alliance" ; dl:statusStatement "v0.2 (2025); open specification, early adoption" ; dl:description "A protocol for payments initiated by agents, using signed mandates and verifiable credentials so that intent, authorisation and execution can each be proven after the fact.", "Payments are where agent autonomy meets regulated ground: strong customer authentication, audit trails and liability all need an answer before an agent may spend anything. The FIDO Alliance has taken up the standardisation work through its agentic authentication and payments working groups." ; dl:referenceLink "https://ap2-protocol.org/"^^xsd:anyURI ; dl:sourceJurisdictionLabel "Global" ; dl:appliesIn tax:jurisdiction-global ; dl:hasGovernanceType tax:governance-community ; dl:evidenceStatus "DIRECT_OBSERVATION" .
inst:standard-odrl dl:describesSameResourceAs inst:regulation-odrl .
inst:standard-opa dl:describesSameResourceAs inst:regulation-opa .
